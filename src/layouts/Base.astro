---
import "@fontsource-variable/nunito";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../../brand/tokens.css";
import "../styles/global.css";
import LanguageSelector from "../components/LanguageSelector.astro";
import CommandPalette from "../components/CommandPalette.astro";
import InstallPrompt from "../components/InstallPrompt.astro";
import logo from "../../brand/logo/logo-icone.svg?raw";
import logoBranco from "../../brand/logo/logo-icone-branco.svg?raw";
import favicon from "../../brand/logo/logo-icone.svg?url";
import { getLocaleFromPath, getLocalizedPath, UI, type Locale } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const path = Astro.url.pathname;
const currentLocale = Astro.props.locale || getLocaleFromPath(path);
const ui = UI[currentLocale];

const { title, description = ui.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${ui.siteName}` : `${ui.siteName} — ${ui.tagline}`;
const htmlLang = currentLocale === "pt" ? "pt-BR" : currentLocale === "zh" ? "zh-CN" : currentLocale;
const homeUrl = currentLocale === "pt" ? "/" : `/${currentLocale}/`;
const madeInBrazil = {
  pt: "🇧🇷 Feito no Brasil · 0 Cookies / 0 Trackers · LGPD · GDPR · PIPL · NIST",
  de: "🇧🇷 Hergestellt in Brasilien · 0 Cookies / 0 Tracker · DSGVO · LGPD · PIPL · NIST",
  zh: "🇧🇷 巴西制造 · 零 Cookie / 零追踪 · PIPL · LGPD · GDPR · NIST",
  en: "🇧🇷 Made in Brazil · 0 Cookies / 0 Trackers · LGPD · GDPR · PIPL · NIST",
}[currentLocale];
const legalNav = {
  pt: { priv: "Privacidade & Cookies", terms: "Disclaimers & Termos", privUrl: "/privacidade/", termsUrl: "/termos/" },
  de: { priv: "Datenschutz & Cookies", terms: "Disclaimers & Bedingungen", privUrl: "/de/privacidade/", termsUrl: "/de/termos/" },
  zh: { priv: "隐私与 Cookie 声明", terms: "免责声明与条款", privUrl: "/zh/privacidade/", termsUrl: "/zh/termos/" },
  en: { priv: "Privacy & Cookies", terms: "Disclaimers & Terms", privUrl: "/en/privacidade/", termsUrl: "/en/termos/" },
}[currentLocale];
const ogLocale = { pt: "pt_BR", de: "de_DE", zh: "zh_CN", en: "en_US" }[currentLocale];
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function(){try{
        var ua=navigator.userAgent||'';
        if(/bot|crawler|spider|lighthouse|googlebot|bingbot|baiduspider|yandex|slurp|duckduckbot/i.test(ua))return;
        if(localStorage.getItem('is_lang_pref')||sessionStorage.getItem('is_lang_auto'))return;
        var p=location.pathname;
        if(/^\/(de|zh|en)(\/|$)/.test(p))return;
        var tz=(Intl.DateTimeFormat().resolvedOptions().timeZone||'');
        var target='';
        if(/^(America\/(Sao_Paulo|Fortaleza|Recife|Bahia|Belem|Manaus|Cuiaba|Porto_Velho|Boa_Vista|Rio_Branco|Campo_Grande|Maceio|Araguaina|Noronha|Santarem|Eirunepe)|Brazil\/|Europe\/Lisbon|Atlantic\/(Madeira|Azores|Cape_Verde)|Africa\/(Luanda|Maputo|Bissau|Sao_Tome)|Asia\/Dili)/.test(tz)){target='pt';}
        else if(/^Europe\/(Berlin|Vienna|Zurich|Vaduz|Busingen)$/.test(tz)){target='de';}
        else if(/^Asia\/(Shanghai|Chongqing|Harbin|Urumqi|Hong_Kong|Macau|Taipei)$/.test(tz)){target='zh';}
        if(!target){
          var langs=(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||'']).map(function(l){return l.toLowerCase();});
          target='en';
          for(var i=0;i<langs.length;i++){
            var l=langs[i];
            if(l.indexOf('pt')===0){target='pt';break;}
            if(l.indexOf('de')===0){target='de';break;}
            if(l.indexOf('zh')===0){target='zh';break;}
            if(l.indexOf('en')===0){target='en';break;}
          }
        }
        sessionStorage.setItem('is_lang_auto',target);
        if(target!=='pt'){
          var next='/'+target+(p==='/'?'/':p);
          location.replace(next+location.search+location.hash);
        }
      }catch(e){}})();
    </script>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    
    <!-- PWA Manifest & Chrome / Android Config -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#009C3B" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Identidade Soberana" />
    <meta name="application-name" content="Identidade Soberana" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Fontes 100% locais via @fontsource-variable (Zero requisições externas) + Tema de código -->
    <script is:inline>
      try{var ct=localStorage.getItem('is_code_theme');if(ct==='dark')document.documentElement.dataset.codeTheme='dark';}catch(e){}
    </script>

    <!-- Links Canônicos e hreflang Internacionais para SEO -->
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(getLocalizedPath(path, "pt"), Astro.site)} />
    <link rel="alternate" hreflang="de" href={new URL(getLocalizedPath(path, "de"), Astro.site)} />
    <link rel="alternate" hreflang="zh-Hans" href={new URL(getLocalizedPath(path, "zh"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(getLocalizedPath(path, "en"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(path, "pt"), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Identidade Soberana — RSS Feed" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Diretivas Globais de Indexação para Buscadores (Google, Bing, Baidu, etc.) -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="baiduspider" content="index, follow" />

    <!-- Tags de Verificação de Propriedade (Google Search Console, Bing, Baidu) -->
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />}
    {import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION && <meta name="baidu-site-verification" content={import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION} />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Identidade Soberana" />
    <meta property="og:image" content={new URL("/icons/icon-512.png", Astro.site)} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/icons/icon-512.png", Astro.site)} />

    <link rel="canonical" href={new URL(path, Astro.site)} />

    <!-- Dados Estruturados (JSON-LD) para Search Engines e Robôs de IA -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://identidadesoberana.com.br/#organization",
          "name": "Identidade Soberana",
          "url": "https://identidadesoberana.com.br",
          "logo": "https://identidadesoberana.com.br/icons/icon-512.png",
          "email": "administrador@identidadesoberana.com.br",
          "founder": {
            "@type": "Person",
            "name": "Martyn Figueiredo",
            "url": "https://linkedin.com/in/martynfigueiredo"
          },
          "sameAs": [
            "https://linkedin.com/in/martynfigueiredo"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://identidadesoberana.com.br/#website",
          "url": "https://identidadesoberana.com.br",
          "name": "Identidade Soberana",
          "description": "Segurança digital sem complicação. Conteúdo para SOC, IAM e Compliance.",
          "publisher": {
            "@id": "https://identidadesoberana.com.br/#organization"
          },
          "inLanguage": htmlLang
        }
      ]
    })} />
  </head>
  <body>
    <div id="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container">
        <a class="marca" href={homeUrl} aria-label={`${ui.siteName} — início`}>
          <Fragment set:html={logo} />
          <span class="marca-nome">identidade <b>soberana</b></span>
        </a>

        <div class="header-right">
          <nav id="site-nav" class="nav">
            {ui.nav.map((i) => <a href={i.href} aria-current={path === i.href || (i.href !== homeUrl && path.startsWith(i.href)) ? "page" : undefined}>{i.label}</a>)}
          </nav>

          <button id="cmd-open-btn" class="cmd-trigger-btn" type="button" aria-label="Busca rápida (Ctrl+K)" title="Busca rápida (Ctrl+K)">
            <span aria-hidden="true">🔍</span>
            <kbd>Ctrl+K</kbd>
          </button>

          <LanguageSelector />
          
          <button id="mobile-menu-btn" class="mobile-toggle" type="button" aria-label="Abrir menu de navegação" aria-expanded="false">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <CommandPalette locale={currentLocale} />
    <InstallPrompt />

    <button id="back-to-top" class="back-to-top" type="button" aria-label="Voltar ao topo" title="Voltar ao topo" hidden>↑</button>

    <footer class="site-footer">
      <svg class="fita" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 40 C 240 10, 480 10, 720 35 S 1200 62, 1440 30" fill="none" stroke="#FFDF00" stroke-width="8" />
        <path d="M0 52 C 240 22, 480 22, 720 47 S 1200 74, 1440 42 L1440 70 L0 70 Z" fill="#009C3B" />
      </svg>
      <div class="container">
        <a class="marca" href={homeUrl}>
          <Fragment set:html={logoBranco} />
          <span class="marca-nome">identidade <b>soberana</b></span>
        </a>
        <div style="display:flex;flex-direction:column;gap:.2rem;">
          <span>{ui.footerText}</span>
          <span style="font-size:.82rem;opacity:.92;">{madeInBrazil}</span>
        </div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
          <a href={legalNav.privUrl}>{legalNav.priv}</a>
          <a href={legalNav.termsUrl}>{legalNav.terms}</a>
          <a href="/.well-known/security.txt">security.txt</a>
          <a href="/rss.xml" title="Assinar via RSS">Feed RSS</a>
          <a href="https://linkedin.com/in/martynfigueiredo" rel="me noopener noreferrer" target="_blank">LinkedIn</a>
        </div>
      </div>
    </footer>

    <!-- Service Worker Registration & Mobile Enhancements -->
    <script is:inline>
      // 1. Service Worker para suporte a PWA Offline e Instalação
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => {
            console.warn('ServiceWorker registration failed: ', err);
          });
        });
      }

      // 2. Menu Mobile Toggle & Command Palette Trigger & Back-to-Top
      const menuBtn = document.getElementById('mobile-menu-btn');
      const siteNav = document.getElementById('site-nav');
      if (menuBtn && siteNav) {
        menuBtn.addEventListener('click', () => {
          const isOpen = siteNav.classList.toggle('open');
          menuBtn.setAttribute('aria-expanded', String(isOpen));
        });
      }
      document.getElementById('cmd-open-btn')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-cmd-palette'));
      });
      const backTopBtn = document.getElementById('back-to-top');
      if (backTopBtn) {
        window.addEventListener('scroll', () => {
          backTopBtn.hidden = window.scrollY < 420;
        }, { passive: true });
        backTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 3. Melhorias de leitura, copiabilidade e visualização em todo o site
      document.addEventListener('DOMContentLoaded', () => {
        const prosaEl = document.querySelector('.prosa');
        if (!prosaEl) return;

        const copyIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;

        // Barra de progresso de leitura em artigos
        const progressBar = document.getElementById('reading-progress');
        if (progressBar) {
          const updateProgress = () => {
            const total = document.documentElement.scrollHeight - window.innerHeight;
            const pct = total > 0 ? Math.min(100, Math.max(0, (window.scrollY / total) * 100)) : 0;
            progressBar.style.width = `${pct}%`;
          };
          window.addEventListener('scroll', updateProgress, { passive: true });
          updateProgress();
        }

        // Envolve tabelas em .table-wrapper e adiciona botão Copiar Tabela (Markdown)
        document.querySelectorAll('.prosa table').forEach(tbl => {
          let wrapper = tbl.parentElement;
          if (!wrapper || !wrapper.classList.contains('table-wrapper')) {
            wrapper = document.createElement('div');
            wrapper.className = 'table-wrapper';
            tbl.parentNode.insertBefore(wrapper, tbl);
            wrapper.appendChild(tbl);
          }

          if (!wrapper.querySelector('.copy-table-btn')) {
            const tBtn = document.createElement('button');
            tBtn.type = 'button';
            tBtn.className = 'copy-table-btn';
            tBtn.setAttribute('aria-label', 'Copiar tabela');
            tBtn.innerHTML = `${copyIcon} Copiar tabela`;
            tBtn.addEventListener('click', async () => {
              const rows = Array.from(tbl.querySelectorAll('tr')).map(tr =>
                Array.from(tr.querySelectorAll('th, td')).map(cell => cell.innerText.replace(/\s+/g, ' ').trim())
              );
              const md = rows.map((r, idx) => {
                const line = `| ${r.join(' | ')} |`;
                if (idx === 0) {
                  return `${line}\n| ${r.map(() => '---').join(' | ')} |`;
                }
                return line;
              }).join('\n');
              try {
                await navigator.clipboard.writeText(md);
                tBtn.innerHTML = `✔ Tabela copiada!`;
                tBtn.style.color = 'var(--is-verde)';
                setTimeout(() => {
                  tBtn.innerHTML = `${copyIcon} Copiar tabela`;
                  tBtn.style.color = '';
                }, 2000);
              } catch (err) {
                console.error('Falha ao copiar tabela:', err);
              }
            });
            wrapper.appendChild(tBtn);
          }
        });

        // Adiciona botão de copiar link de seção nos títulos (h2, h3)
        document.querySelectorAll('.prosa h2[id], .prosa h3[id]').forEach(heading => {
          if (heading.querySelector('.heading-copy-btn')) return;
          const hBtn = document.createElement('button');
          hBtn.type = 'button';
          hBtn.className = 'heading-copy-btn';
          hBtn.setAttribute('aria-label', 'Copiar link desta seção');
          hBtn.title = 'Copiar link da seção';
          hBtn.textContent = '#';
          hBtn.addEventListener('click', async () => {
            const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
            try {
              await navigator.clipboard.writeText(url);
              hBtn.textContent = '✔';
              setTimeout(() => { hBtn.textContent = '#'; }, 1500);
            } catch (err) {
              console.error('Falha ao copiar link:', err);
            }
          });
          heading.appendChild(hBtn);
        });

        // Adiciona proteção notranslate, alternador Terminal Escuro e botão de copiar código
        const syncThemeBtns = () => {
          const isDark = document.documentElement.dataset.codeTheme === 'dark';
          document.querySelectorAll('.code-theme-btn').forEach(b => {
            b.textContent = isDark ? '☀️ Claro' : '🌙 Terminal';
          });
        };

        document.querySelectorAll('.prosa pre').forEach(pre => {
          pre.setAttribute('translate', 'no');
          pre.classList.add('notranslate');

          const themeBtn = document.createElement('button');
          themeBtn.type = 'button';
          themeBtn.className = 'code-theme-btn';
          themeBtn.setAttribute('aria-label', 'Alternar tema do bloco de código');
          themeBtn.addEventListener('click', () => {
            const next = document.documentElement.dataset.codeTheme === 'dark' ? '' : 'dark';
            if (next) document.documentElement.dataset.codeTheme = 'dark';
            else delete document.documentElement.dataset.codeTheme;
            try { localStorage.setItem('is_code_theme', next || 'light'); } catch {}
            syncThemeBtns();
          });

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-code-btn';
          btn.setAttribute('aria-label', 'Copiar código');
          btn.innerHTML = `${copyIcon} Copiar`;
          
          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const code = codeEl ? codeEl.innerText : Array.from(pre.childNodes).filter(n => n !== btn && n !== themeBtn).map(n => n.textContent).join('');
            try {
              await navigator.clipboard.writeText(code.trimEnd());
              btn.innerHTML = `✔ Copiado!`;
              btn.style.color = 'var(--is-verde)';
              setTimeout(() => {
                btn.innerHTML = `${copyIcon} Copiar`;
                btn.style.color = '';
              }, 2000);
            } catch (err) {
              console.error('Falha ao copiar:', err);
            }
          });

          pre.appendChild(themeBtn);
          pre.appendChild(btn);
        });
        syncThemeBtns();
      });
    </script>
  </body>
</html>

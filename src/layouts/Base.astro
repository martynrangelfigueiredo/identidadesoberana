---
import "../../brand/tokens.css";
import "../styles/global.css";
import logo from "../../brand/logo/logo-icone.svg?raw";
import logoBranco from "../../brand/logo/logo-icone-branco.svg?raw";
import favicon from "../../brand/logo/logo-icone.svg?url";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "Segurança digital sem complicação. Conteúdo para SOC, IAM e Compliance." } = Astro.props;
const fullTitle = title ? `${title} · Identidade Soberana` : "Identidade Soberana — Segurança digital sem complicação";
const path = Astro.url.pathname;
const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/categoria/soc/", label: "SOC" },
  { href: "/categoria/iam/", label: "IAM" },
  { href: "/categoria/compliance/", label: "Compliance" },
  { href: "/categoria/privacidade/", label: "Privacidade" },
  { href: "/sobre/", label: "Sobre" },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="theme-color" content="#009C3B" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Identidade Soberana" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="marca" href="/" aria-label="Identidade Soberana — início">
          <Fragment set:html={logo} />
          <span class="marca-nome">identidade <b>soberana</b></span>
        </a>
        <nav class="nav">
          {nav.map((i) => <a href={i.href} aria-current={path.startsWith(i.href) ? "page" : undefined}>{i.label}</a>)}
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <svg class="fita" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 40 C 240 10, 480 10, 720 35 S 1200 62, 1440 30" fill="none" stroke="#FFDF00" stroke-width="8" />
        <path d="M0 52 C 240 22, 480 22, 720 47 S 1200 74, 1440 42 L1440 70 L0 70 Z" fill="#009C3B" />
      </svg>
      <div class="container">
        <a class="marca" href="/">
          <Fragment set:html={logoBranco} />
          <span class="marca-nome">identidade <b>soberana</b></span>
        </a>
        <span>Segurança digital sem complicação.</span>
        <a href="https://instagram.com/identidadesoberana" rel="me noopener">Instagram @identidadesoberana</a>
      </div>
    </footer>
  </body>
</html>


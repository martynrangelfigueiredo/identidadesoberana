---
import { UI, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  url: string;
  locale?: Locale;
  category?: string;
  date?: string;
  level?: string;
  tags?: string[];
}

const {
  title,
  description = "",
  url,
  locale = "pt",
  category = "SOC",
  date = "",
  level = "",
  tags = []
} = Astro.props;
const t = UI[locale].share;

const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(`${title} — Identidade Soberana`);

const shareLinks = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>`,
    color: "#0a66c2",
  },
  {
    name: "X (Twitter)",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`,
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    color: "#000000",
  },
  {
    name: "WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodedText}%20${encodedUrl}`,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.41a8.188 8.188 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z"/></svg>`,
    color: "#25D366",
  },
];
---

<div
  class="share-box"
  data-url={url}
  data-title={title}
  data-desc={description}
  data-category={category}
  data-date={date}
  data-level={level}
  data-tags={JSON.stringify(tags)}
  data-locale={locale}
>
  <div class="share-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span>{t.title}</span>
  </div>

  <div class="share-actions">
    <!-- Botão Story do Instagram com Prévia Dinâmica -->
    <button type="button" class="share-btn story-trigger-btn" aria-label={t.story} title={t.story}>
      <svg class="icon-story" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      <span>{t.story}</span>
    </button>

    <button type="button" class="btn-share-native" aria-label={t.native} style="display:none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
        <polyline points="16 6 12 2 8 6"></polyline>
        <line x1="12" y1="2" x2="12" y2="15"></line>
      </svg>
      <span>{t.native}</span>
    </button>

    {shareLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="share-btn"
        aria-label={`Compartilhar no ${link.name}`}
        title={`Compartilhar no ${link.name}`}
      >
        <Fragment set:html={link.icon} />
        <span>{link.name}</span>
      </a>
    ))}

    <button type="button" class="share-btn copy-btn" aria-label={t.copy} data-copied={t.copied} data-default={t.copy}>
      <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="copy-label">{t.copy}</span>
    </button>
  </div>

  <!-- Modal Interativo: Prévia de Card para Instagram Story -->
  <div class="story-modal-overlay" style="display:none;" aria-hidden="true">
    <div class="story-modal-container" role="dialog" aria-modal="true" aria-labelledby="story-modal-title">
      <div class="story-modal-header">
        <div class="story-modal-title" id="story-modal-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <strong>{t.storyPreview}</strong>
        </div>
        <button type="button" class="story-modal-close" aria-label={t.close}>&times;</button>
      </div>

      <div class="story-modal-content">
        <!-- Coluna da Esquerda: Prévia em Proporção 9:16 -->
        <div class="story-preview-wrapper">
          <canvas width="1080" height="1920" class="story-canvas"></canvas>
        </div>

        <!-- Coluna da Direita: Instruções e Ações -->
        <div class="story-actions-wrapper">
          <div class="story-btn-group">
            <button type="button" class="btn-story-action primary-share">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
              </svg>
              <span>{t.storyShare}</span>
            </button>

            <button type="button" class="btn-story-action secondary-copy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="story-copy-status">{t.copy}</span>
            </button>
          </div>

          <div class="story-instructions-card">
            <h4>{t.storyHowTo}</h4>
            <div class="story-notice-badge">
              <span>{t.storyNotice}</span>
            </div>
            <ol>
              <li>
                <span class="step-num">1</span>
                <span>{t.storyStep1}</span>
              </li>
              <li>
                <span class="step-num">2</span>
                <span>{t.storyStep2}</span>
              </li>
              <li>
                <span class="step-num">3</span>
                <span>{t.storyStep3}</span>
              </li>
            </ol>
            <p class="story-tip">💡 No Instagram, qualquer pessoa que ver seu Story poderá tocar na figurinha e abrir o artigo direto!</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .share-box {
    margin: 3rem 0 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--is-verde-nevoa);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .share-header {
    display: flex;
    align-items: center;
    gap: .5rem;
    font: 800 .95rem var(--is-fonte-titulo);
    color: var(--is-verde-escuro);
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
  }

  .share-btn,
  .btn-share-native {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .45rem .85rem;
    background: var(--is-branco);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-pill);
    color: var(--is-tinta);
    font: 600 .85rem var(--is-fonte-texto);
    text-decoration: none !important;
    cursor: pointer;
    box-shadow: var(--is-sombra-1);
    transition: all .15s ease;
  }

  .share-btn:hover,
  .btn-share-native:hover {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
    transform: translateY(-1px);
  }

  .icon-story {
    color: var(--is-cinza);
    transition: color .15s ease;
  }

  .share-btn:hover .icon-story {
    color: var(--is-verde-escuro);
  }

  .btn-share-native {
    background: var(--is-verde);
    color: var(--is-branco);
    border-color: var(--is-verde);
  }
  .btn-share-native:hover {
    background: var(--is-verde-escuro);
    color: var(--is-branco);
  }

  .copy-btn.copied {
    background: var(--is-verde-claro);
    border-color: var(--is-verde);
    color: var(--is-verde-escuro);
  }

  /* Modal do Story */
  .story-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(27, 43, 34, 0.7);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: modalFadeIn .2s ease-out;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .story-modal-container {
    background: var(--is-branco);
    border-radius: var(--is-raio-lg);
    box-shadow: var(--is-sombra-3);
    max-width: 780px;
    width: 100%;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--is-borda);
    animation: modalSlideUp .25s cubic-bezier(.16, 1, .3, 1);
  }

  @keyframes modalSlideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .story-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--is-borda);
    background: var(--is-verde-nevoa);
  }
  .story-modal-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--is-verde-escuro);
    font: 800 1.05rem var(--is-fonte-titulo);
  }
  .story-modal-close {
    background: transparent;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--is-cinza);
    cursor: pointer;
    padding: .2rem .5rem;
    border-radius: var(--is-raio-sm);
  }
  .story-modal-close:hover {
    color: var(--is-tinta);
    background: var(--is-verde-claro);
  }

  .story-modal-content {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem;
    overflow-y: auto;
    align-items: flex-start;
  }

  .story-preview-wrapper {
    flex-shrink: 0;
    width: 220px;
    aspect-ratio: 9/16;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 97, 42, 0.15), 0 2px 6px rgba(0,0,0,0.06);
    border: 1px solid var(--is-borda);
    background: #000;
  }
  .story-canvas {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .story-actions-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .story-btn-group {
    display: flex;
    flex-direction: column;
    gap: .65rem;
  }

  .btn-story-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .75rem 1.25rem;
    border-radius: var(--is-raio-pill);
    font: 700 .95rem var(--is-fonte-titulo);
    cursor: pointer;
    transition: all .15s ease;
    border: none;
  }
  .btn-story-action.primary-share {
    background: var(--is-verde);
    color: var(--is-branco);
    box-shadow: 0 4px 12px rgba(0, 156, 59, 0.25);
  }
  .btn-story-action.primary-share:hover {
    background: var(--is-verde-escuro);
    transform: translateY(-1px);
  }

  .btn-story-action.secondary-copy {
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
    border: 1px solid var(--is-borda);
  }
  .btn-story-action.secondary-copy:hover {
    background: #D5EDDF;
  }

  .story-instructions-card {
    background: var(--is-verde-nevoa);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-md);
    padding: 1rem 1.15rem;
  }
  .story-instructions-card h4 {
    margin: 0 0 .75rem;
    font-size: .95rem;
    color: var(--is-verde-escuro);
  }
  .story-notice-badge {
    background: var(--is-amarelo-claro);
    border: 1px solid #FFE57F;
    border-radius: var(--is-raio-sm);
    padding: .5rem .75rem;
    font-size: .84rem;
    color: #5C4300;
    font-weight: 600;
    margin-bottom: .75rem;
    line-height: 1.35;
  }
  .story-instructions-card ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }
  .story-instructions-card li {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
    font-size: .88rem;
    line-height: 1.4;
    color: var(--is-tinta);
  }
  .step-num {
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
    font: 800 .78rem var(--is-fonte-titulo);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .story-tip {
    margin: .85rem 0 0;
    padding-top: .75rem;
    border-top: 1px dashed var(--is-borda);
    font-size: .8rem;
    color: var(--is-cinza);
    line-height: 1.4;
  }

  @media (max-width: 650px) {
    .story-modal-content {
      flex-direction: column;
      align-items: center;
    }
    .story-preview-wrapper {
      width: 170px;
    }
    .story-actions-wrapper {
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .share-box {
      padding: 1rem;
    }
    .share-btn span {
      font-size: .8rem;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.share-box').forEach((box) => {
    const url = box.dataset.url || window.location.href;
    const title = box.dataset.title || document.title;
    const text = box.dataset.desc || '';
    const category = box.dataset.category || 'IAM';
    const date = box.dataset.date || '';
    const level = box.dataset.level || '';
    const locale = box.dataset.locale || 'pt';
    let tags = [];
    try {
      tags = JSON.parse(box.dataset.tags || '[]');
    } catch (e) {
      tags = [];
    }

    // 1. Web Share API nativa geral
    const nativeBtn = box.querySelector('.btn-share-native');
    if (nativeBtn && navigator.share) {
      nativeBtn.style.display = 'inline-flex';
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({ title, text, url });
        } catch (err) {}
      });
    }

    // 2. Copiar Link geral
    const copyBtn = box.querySelector('.copy-btn');
    if (copyBtn) {
      const copyLabel = copyBtn.querySelector('.copy-label');
      const copiedText = copyBtn.dataset.copied || 'Copiado!';
      const defaultText = copyBtn.dataset.default || 'Copiar link';

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.classList.add('copied');
          if (copyLabel) copyLabel.textContent = `✔ ${copiedText}`;
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            if (copyLabel) copyLabel.textContent = defaultText;
          }, 2000);
        } catch (err) {
          console.error('Falha ao copiar link:', err);
        }
      });
    }

    // 3. Gerador e Modal de Instagram Story com Canvas
    const storyTriggerBtn = box.querySelector('.story-trigger-btn');
    const storyModal = box.querySelector('.story-modal-overlay');
    const storyCloseBtn = box.querySelector('.story-modal-close');
    const storyCanvas = box.querySelector('.story-canvas');
    const storyShareBtn = box.querySelector('.primary-share');
    const storyCopyBtn = box.querySelector('.secondary-copy');
    const storyCopyStatus = box.querySelector('.story-copy-status');

    let cachedBlob = null;

    // Função de quebra de linhas para o Canvas
    function wrapText(ctx, text, x, y, maxWidth, lineHeight, maxLines) {
      if (!text) return y;
      const words = text.split(' ');
      let line = '';
      let currentY = y;
      let lineCount = 0;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = ctx.measureText(testLine);
        const testWidth = metrics.width;
        if (testWidth > maxWidth && n > 0) {
          lineCount++;
          if (maxLines && lineCount >= maxLines) {
            ctx.fillText(line.trim() + '...', x, currentY);
            return currentY + lineHeight;
          }
          ctx.fillText(line.trim(), x, currentY);
          line = words[n] + ' ';
          currentY += lineHeight;
        } else {
          line = testLine;
        }
      }
      ctx.fillText(line.trim(), x, currentY);
      return currentY + lineHeight;
    }

    // Renderiza o Story Card 9:16 (1080x1920)
    function renderStoryCard() {
      if (!storyCanvas) return;
      const ctx = storyCanvas.getContext('2d');
      const W = 1080;
      const H = 1920;

      const i18nLabels = {
        pt: {
          guide: 'GUIA TÉCNICO',
          topics: 'TÓPICOS & TECNOLOGIAS:',
          linkDrop: '🔗 Cole sua figurinha de Link aqui',
          linkInstruction: '(Toque nas figurinhas do Instagram > figurinha LINK)',
          footerSub: 'Conteúdo prático para analistas de SOC, IAM e Compliance',
          since: 'Desde 2026 · Nuvem Aberta & Defesa Cloud',
        },
        de: {
          guide: 'TECHNISCHER LEITFADEN',
          topics: 'THEMEN & TECHNOLOGIEN:',
          linkDrop: '🔗 Platziere deinen Link-Sticker hier',
          linkInstruction: '(In Instagram Stories auf Sticker > LINK tippen)',
          footerSub: 'Praxisnahe Leitfäden für SOC-, IAM- und Compliance-Teams',
          since: 'Seit 2026 · Open Cloud & Cloud-Sicherheit',
        },
        zh: {
          guide: '实战技术指南',
          topics: '核心要点与技术栈：',
          linkDrop: '🔗 在此处添加「链接」贴纸',
          linkInstruction: '(在 Instagram 快拍点击贴纸图标 > 选择「链接」)',
          footerSub: '面向 SOC 分析师、IAM 团队与合规人员的实战内容',
          since: '始于 2026 · 开源云与云端防御',
        },
        en: {
          guide: 'TECHNICAL GUIDE',
          topics: 'TOPICS & TECHNOLOGIES:',
          linkDrop: '🔗 Place your Link sticker here',
          linkInstruction: '(Tap stickers icon in Instagram > select LINK)',
          footerSub: 'Hands-on guides for SOC, IAM, and Compliance teams',
          since: 'Since 2026 · Open Cloud & Cloud Defense',
        },
      };

      const lbl = i18nLabels[locale] || i18nLabels.pt;

      // 1. Fundo com gradiente suave e limpo
      const bgGrad = ctx.createLinearGradient(0, 0, 0, H);
      bgGrad.addColorStop(0, '#FFFFFF');
      bgGrad.addColorStop(0.35, '#F7FAF8');
      bgGrad.addColorStop(1, '#EBF6EF');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, W, H);

      // Faixa verde de destaque no topo
      ctx.fillStyle = '#009C3B';
      ctx.fillRect(0, 0, W, 20);

      // 2. Cabeçalho Superior: Marca à esquerda, Badges à direita
      ctx.fillStyle = '#00612A';
      ctx.font = '900 40px Nunito, Inter, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('identidade soberana', 72, 115);

      ctx.fillStyle = '#5B6B62';
      ctx.font = '600 22px Inter, sans-serif';
      ctx.fillText('Engenharia de Segurança · IAM · SOC', 72, 150);

      // Badges à direita: Categoria + Nível
      let badgeRightX = W - 72;
      const badgesToDraw = [];
      if (level) {
        badgesToDraw.push({ text: level.toUpperCase(), bg: '#E6F5EC', fg: '#00612A', border: '#B8DFCA' });
      }
      if (category) {
        badgesToDraw.push({ text: category.toUpperCase(), bg: '#009C3B', fg: '#FFFFFF', border: '#009C3B' });
      }

      ctx.font = '800 24px Nunito, Inter, sans-serif';
      for (const badge of badgesToDraw) {
        const textW = ctx.measureText(badge.text).width;
        const pillW = textW + 36;
        const pillH = 46;
        const pillX = badgeRightX - pillW;
        const pillY = 108;

        ctx.fillStyle = badge.bg;
        ctx.beginPath();
        ctx.roundRect(pillX, pillY, pillW, pillH, 23);
        ctx.fill();

        if (badge.border && badge.border !== badge.bg) {
          ctx.lineWidth = 2;
          ctx.strokeStyle = badge.border;
          ctx.stroke();
        }

        ctx.fillStyle = badge.fg;
        ctx.fillText(badge.text, pillX + 18, pillY + 32);
        badgeRightX = pillX - 12;
      }

      // 3. Card Central Branco com sombra suave
      const cardX = 64;
      const cardY = 180;
      const cardW = W - 128; // 952px
      const cardH = 1470;

      ctx.save();
      ctx.shadowColor = 'rgba(0, 97, 42, 0.08)';
      ctx.shadowBlur = 36;
      ctx.shadowOffsetY = 14;
      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.roundRect(cardX, cardY, cardW, cardH, 36);
      ctx.fill();
      ctx.restore();

      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#DDE7E0';
      ctx.stroke();

      // Conteúdo Interno do Card
      const innerX = cardX + 54;
      const innerW = cardW - 108; // 844px
      let cursorY = cardY + 70;

      // Meta: Data e Tipo de Conteúdo
      ctx.textAlign = 'left';
      ctx.fillStyle = '#5B6B62';
      ctx.font = '700 24px Inter, sans-serif';
      const metaString = date ? `📅 ${date}   ·   📖 ${lbl.guide}` : `📖 ${lbl.guide}`;
      ctx.fillText(metaString, innerX, cursorY);
      cursorY += 48;

      // Título do Artigo (em até 4 linhas)
      ctx.fillStyle = '#1B2B22';
      ctx.font = '900 50px Nunito, Inter, sans-serif';
      cursorY = wrapText(ctx, title, innerX, cursorY, innerW, 66, 4);
      cursorY += 16;

      // Barra divisória verde
      ctx.fillStyle = '#009C3B';
      ctx.fillRect(innerX, cursorY, 90, 5);
      cursorY += 34;

      // Descrição Técnica Completa (em até 4-5 linhas)
      ctx.fillStyle = '#3A4B42';
      ctx.font = '500 29px Inter, sans-serif';
      cursorY = wrapText(ctx, text, innerX, cursorY, innerW, 46, 5);
      cursorY += 28;

      // Box de Tópicos e Stack Técnica (se houver tags)
      if (tags && tags.length > 0) {
        const boxPad = 22;
        const boxX = innerX;
        const boxW = innerW;
        const boxY = cursorY;
        const maxTags = tags.slice(0, 7);

        ctx.font = '700 22px "JetBrains Mono", Consolas, monospace';
        let currentTagX = boxX + boxPad;
        let currentTagY = boxY + 68;
        let linesCount = 1;
        const tagLineH = 46;

        for (const tag of maxTags) {
          const tagLabel = '#' + tag;
          const tagW = ctx.measureText(tagLabel).width + 28;
          if (currentTagX + tagW > boxX + boxW - boxPad && currentTagX > boxX + boxPad) {
            currentTagX = boxX + boxPad;
            currentTagY += tagLineH;
            linesCount++;
          }
          currentTagX += tagW + 12;
        }

        const boxH = 68 + linesCount * tagLineH + 6;

        // Fundo do box de tópicos
        ctx.fillStyle = '#F7FAF8';
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 20);
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = '#E2EAE5';
        ctx.stroke();

        // Título do box
        ctx.fillStyle = '#00612A';
        ctx.font = '800 23px Nunito, Inter, sans-serif';
        ctx.fillText(lbl.topics, boxX + boxPad, boxY + 38);

        // Desenhar os badges de tags
        ctx.font = '700 21px "JetBrains Mono", Consolas, monospace';
        currentTagX = boxX + boxPad;
        currentTagY = boxY + 58;

        for (const tag of maxTags) {
          const tagLabel = '#' + tag;
          const tagW = ctx.measureText(tagLabel).width + 26;
          const tagH = 36;

          if (currentTagX + tagW > boxX + boxW - boxPad && currentTagX > boxX + boxPad) {
            currentTagX = boxX + boxPad;
            currentTagY += tagLineH;
          }

          // Badge Pill da Tag
          ctx.fillStyle = '#FFFFFF';
          ctx.beginPath();
          ctx.roundRect(currentTagX, currentTagY, tagW, tagH, 10);
          ctx.fill();
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = '#D5E2D9';
          ctx.stroke();

          ctx.fillStyle = '#00612A';
          ctx.fillText(tagLabel, currentTagX + 13, currentTagY + 25);

          currentTagX += tagW + 12;
        }
      }

      // Área Demarcada da Figurinha de Link do Instagram
      const stickerW = cardW - 100;
      const stickerH = 146;
      const stickerX = cardX + 50;
      const stickerY = cardY + cardH - 186;

      ctx.save();
      ctx.fillStyle = '#F3FAF5';
      ctx.beginPath();
      ctx.roundRect(stickerX, stickerY, stickerW, stickerH, 26);
      ctx.fill();

      ctx.lineWidth = 3.5;
      ctx.setLineDash([16, 12]);
      ctx.strokeStyle = '#009C3B';
      ctx.stroke();
      ctx.restore();

      // Texto de instrução dentro da demarcação
      ctx.textAlign = 'center';
      ctx.fillStyle = '#00612A';
      ctx.font = '900 33px Nunito, Inter, sans-serif';
      ctx.fillText(lbl.linkDrop, cardX + cardW / 2, stickerY + 58);

      ctx.fillStyle = '#5B6B62';
      ctx.font = '600 23px Inter, sans-serif';
      ctx.fillText(lbl.linkInstruction, cardX + cardW / 2, stickerY + 104);

      // 4. Rodapé do Story (fora do card)
      ctx.textAlign = 'center';
      ctx.fillStyle = '#009C3B';
      ctx.font = '800 29px Nunito, Inter, sans-serif';
      ctx.fillText('identidadesoberana.com.br', W / 2, H - 150);

      ctx.fillStyle = '#5B6B62';
      ctx.font = '600 21px Inter, sans-serif';
      ctx.fillText(lbl.footerSub, W / 2, H - 114);

      ctx.fillStyle = '#8FA196';
      ctx.font = '500 18px Inter, sans-serif';
      ctx.fillText(lbl.since, W / 2, H - 80);
      ctx.textAlign = 'left';

      // Cache do Blob
      storyCanvas.toBlob((blob) => {
        cachedBlob = blob;
      }, 'image/png');
    }

    // Abertura do Modal
    if (storyTriggerBtn && storyModal) {
      storyTriggerBtn.addEventListener('click', async () => {
        storyModal.style.display = 'flex';
        renderStoryCard();

        // Já adianta copiando o link para a área de transferência do usuário
        try {
          await navigator.clipboard.writeText(url);
          if (storyCopyStatus) storyCopyStatus.textContent = '✔ Link copiado!';
        } catch (e) {}
      });
    }

    // Fechamento do Modal
    if (storyCloseBtn && storyModal) {
      storyCloseBtn.addEventListener('click', () => {
        storyModal.style.display = 'none';
      });
      storyModal.addEventListener('click', (e) => {
        if (e.target === storyModal) storyModal.style.display = 'none';
      });
    }

    // Botão de Copiar Link dentro do Modal
    if (storyCopyBtn && storyCopyStatus) {
      storyCopyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          storyCopyStatus.textContent = '✔ Link copiado!';
          setTimeout(() => {
            storyCopyStatus.textContent = 'Copiar link';
          }, 2500);
        } catch (err) {
          console.error('Falha ao copiar:', err);
        }
      });
    }

    // Ação Principal: Compartilhar no Story ou Baixar Imagem
    if (storyShareBtn) {
      storyShareBtn.addEventListener('click', async () => {
        // 1. Garante que o link está no clipboard
        try {
          await navigator.clipboard.writeText(url);
        } catch (e) {}

        const slug = window.location.pathname.replace(/\/$/, '').split('/').pop() || 'artigo';
        const fileName = `story-${slug}.png`;

        if (cachedBlob) {
          const file = new File([cachedBlob], fileName, { type: 'image/png' });

          // Se o dispositivo móvel suportar compartilhamento nativo de arquivos
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            try {
              await navigator.share({
                title,
                text: 'Leia o artigo completo com a figurinha de link!',
                files: [file],
              });
              return;
            } catch (err) {
              // Se usuário cancelou o menu, nada a fazer
            }
          }

          // Fallback universal: Baixa a imagem diretamente e orienta o usuário
          const downloadUrl = URL.createObjectURL(cachedBlob);
          const a = document.createElement('a');
          a.href = downloadUrl;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(downloadUrl);

          if (storyCopyStatus) {
            storyCopyStatus.textContent = '✔ Imagem salva e link copiado!';
          }
        }
      });
    }
  });
</script>

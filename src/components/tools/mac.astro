---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "mac")!;
const T = {
  pt: { h2: "Analisar ou Gerar MAC Address", btnAn: "Analisar MAC", btnGen: "Gerar MAC Aleatório", h2Res: "Formatos & Propriedades" },
  de: { h2: "MAC-Adresse analysieren oder generieren", btnAn: "MAC analysieren", btnGen: "Zufalls-MAC generieren", h2Res: "Formate & Eigenschaften" },
  zh: { h2: "解析或生成 MAC 地址", btnAn: "解析 MAC", btnGen: "生成随机 MAC", h2Res: "格式转换与属性" },
  en: { h2: "Analyze or Generate MAC Address", btnAn: "Analyze MAC", btnGen: "Generate Random MAC", h2Res: "Formats & Properties" },
}[locale];
const L = {
  pt: {
    invalid: "MAC Address inválido. Informe 12 dígitos hexadecimais.",
    std: "Formato Padrão (:)", win: "Formato Windows (-)", cisco: "Formato Cisco (.)",
    oui: "OUI (Prefixo Fabricante)", tx: "Transmissão", adm: "Administração",
    laa: "LAA — Localmente Administrado / Randomizado", uaa: "UAA — Universal (Fábrica)",
    done: "MAC Address analisado com sucesso.",
  },
  de: {
    invalid: "Ungültige MAC-Adresse. Geben Sie 12 Hex-Zeichen ein.",
    std: "Standardformat (:)", win: "Windows-Format (-)", cisco: "Cisco-Format (.)",
    oui: "OUI (Herstellerpräfix)", tx: "Übertragung", adm: "Verwaltung",
    laa: "LAA — Lokal verwaltet / Randomisiert", uaa: "UAA — Universal (Werk)",
    done: "MAC-Adresse erfolgreich analysiert.",
  },
  zh: {
    invalid: "MAC 地址无效，请输入 12 位十六进制字符。",
    std: "标准格式 (:)", win: "Windows 格式 (-)", cisco: "Cisco 格式 (.)",
    oui: "OUI（厂商前缀）", tx: "传输类型", adm: "管理方式",
    laa: "LAA — 本地管理 / 随机化地址", uaa: "UAA — 全球唯一（出厂）",
    done: "MAC 地址解析成功。",
  },
  en: {
    invalid: "Invalid MAC Address. Enter 12 hexadecimal digits.",
    std: "Standard Format (:)", win: "Windows Format (-)", cisco: "Cisco Format (.)",
    oui: "OUI (Vendor Prefix)", tx: "Transmission", adm: "Administration",
    laa: "LAA — Locally Administered / Randomized", uaa: "UAA — Universal (Factory)",
    done: "MAC Address analyzed successfully.",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="MAC & EUI-64"
  icon="🔌"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <div class="tool-form-row">
      <input id="mac-in" type="text" class="tool-input" value="00:1A:2B:3C:4D:5E" placeholder="00:1A:2B:3C:4D:5E" aria-label="MAC" />
      <button id="btn-mac" type="button" class="tool-btn">{T.btnAn}</button>
      <button id="btn-mac-gen" type="button" class="tool-btn secondary">{T.btnGen}</button>
    </div>
    <p id="mac-status" class="status-msg"></p>
  </div>

  <div class="tool-card">
    <h2>{T.h2Res}</h2>
    <div id="mac-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const input = document.getElementById('mac-in');
    const grid = document.getElementById('mac-grid');
    const statusEl = document.getElementById('mac-status');

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value}</div>`;
      grid.appendChild(box);
    }

    function analyze() {
      const clean = input.value.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
      grid.innerHTML = '';
      if (clean.length !== 12) {
        statusEl.textContent = L.invalid;
        statusEl.className = 'status-msg error';
        return;
      }

      const bytes = clean.match(/.{2}/g);
      const b0 = parseInt(bytes[0], 16);
      const isMulticast = (b0 & 1) === 1;
      const isLocal = (b0 & 2) === 2;
      const oui = `${bytes[0]}:${bytes[1]}:${bytes[2]}`;

      // EUI-64
      const euiB0 = (b0 ^ 2).toString(16).padStart(2, '0').toLowerCase();
      const eui64 = `fe80::${euiB0}${bytes[1].toLowerCase()}:${bytes[2].toLowerCase()}ff:fe${bytes[3].toLowerCase()}:${bytes[4].toLowerCase()}${bytes[5].toLowerCase()}`;

      addKv(L.std, bytes.join(':'));
      addKv(L.win, bytes.join('-'));
      addKv(L.cisco, `${bytes[0]}${bytes[1]}.${bytes[2]}${bytes[3]}.${bytes[4]}${bytes[5]}`.toLowerCase());
      addKv(L.oui, oui);
      addKv(L.tx, isMulticast ? 'Multicast (Bit 0 = 1)' : 'Unicast (Bit 0 = 0)');
      addKv(L.adm, isLocal ? L.laa : L.uaa);
      addKv('IPv6 Link-Local (EUI-64)', eui64);

      statusEl.textContent = L.done;
      statusEl.className = 'status-msg ok';
    }

    document.getElementById('btn-mac')?.addEventListener('click', analyze);
    document.getElementById('btn-mac-gen')?.addEventListener('click', () => {
      const b = new Uint8Array(6);
      crypto.getRandomValues(b);
      // Set locally administered (bit 1) and unicast (bit 0 = 0)
      b[0] = (b[0] | 0x02) & 0xfe;
      input.value = Array.from(b, (x) => x.toString(16).padStart(2, '0').toUpperCase()).join(':');
      analyze();
    });

    analyze();
  })();
</script>


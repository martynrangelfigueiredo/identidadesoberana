---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "distance")!;
const T = {
  pt: { h2: "Coordenadas e Intervalo de Tempo", orig: "Origem (Lat, Lon)", dest: "Destino (Lat, Lon)", delta: "Intervalo entre Logins (Minutos)", btn: "Calcular Plausibilidade", h2Res: "Resultado da Análise Geográfica" },
  de: { h2: "Koordinaten & Zeitintervall", orig: "Ursprung (Lat, Lon)", dest: "Ziel (Lat, Lon)", delta: "Zeitabstand zwischen Logins (Min.)", btn: "Plausibilität berechnen", h2Res: "Ergebnis der geografischen Analyse" },
  zh: { h2: "地理坐标与登录时间间隔", orig: "起点（纬度, 经度）", dest: "终点（纬度, 经度）", delta: "两次登录间隔（分钟）", btn: "计算合理性", h2Res: "地理分析结果" },
  en: { h2: "Coordinates & Time Interval", orig: "Origin (Lat, Lon)", dest: "Destination (Lat, Lon)", delta: "Time Between Logins (Minutes)", btn: "Calculate Plausibility", h2Res: "Geographic Analysis Result" },
}[locale];
const L = {
  pt: {
    plausible: "Plausível (Deslocamento Terrestre / Aéreo Normal)",
    impossible: "VIAGEM IMPOSSÍVEL (> 950 km/h) — Suspeita de VPN, Proxy ou Credencial Comprometida",
    highSpeed: "Alta Velocidade (Possível Voo Comercial ou Troca de Torre/IP de Operadora)",
    dist: "Distância Geodésica", speed: "Velocidade Necessária", verdict: "Veredito SOC",
  },
  de: {
    plausible: "Plausibel (Normale Land- / Flugreise)",
    impossible: "UNMÖGLICHE REISE (> 950 km/h) — Verdacht auf VPN, Proxy oder kompromittierte Zugangsdaten",
    highSpeed: "Hohe Geschwindigkeit (Möglicher Linienflug oder Mobilfunk-/IP-Wechsel)",
    dist: "Geodätische Entfernung", speed: "Erforderliche Geschwindigkeit", verdict: "SOC-Urteil",
  },
  zh: {
    plausible: "合理（正常地面或航空出行）",
    impossible: "不可能的旅行（> 950 km/h）— 疑似 VPN、代理或凭据泄露",
    highSpeed: "高速移动（可能为商业航班或运营商基站/IP 切换）",
    dist: "地理测地距离", speed: "所需平均速度", verdict: "SOC 判定结果",
  },
  en: {
    plausible: "Plausible (Normal Ground / Air Travel)",
    impossible: "IMPOSSIBLE TRAVEL (> 950 km/h) — Suspected VPN, Proxy, or Compromised Credential",
    highSpeed: "High Speed (Possible Commercial Flight or Carrier Tower/IP Switch)",
    dist: "Geodesic Distance", speed: "Required Speed", verdict: "SOC Verdict",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Geo Risk"
  icon="✈️"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem;">
      <button type="button" class="tool-btn secondary preset-btn" data-p="sp-fra">São Paulo ↔ Frankfurt (15 min)</button>
      <button type="button" class="tool-btn secondary preset-btn" data-p="sp-rj">São Paulo ↔ Rio de Janeiro (45 min)</button>
      <button type="button" class="tool-btn secondary preset-btn" data-p="ny-ldn">New York ↔ London (2h)</button>
    </div>

    <div class="tool-grid" style="margin-bottom:1rem;">
      <div>
        <div class="kv-label">{T.orig}</div>
        <div style="display:flex;gap:.5rem;">
          <input id="lat1" type="number" step="any" class="tool-input" value="-23.5505" aria-label="Lat 1" />
          <input id="lon1" type="number" step="any" class="tool-input" value="-46.6333" aria-label="Lon 1" />
        </div>
      </div>
      <div>
        <div class="kv-label">{T.dest}</div>
        <div style="display:flex;gap:.5rem;">
          <input id="lat2" type="number" step="any" class="tool-input" value="50.1109" aria-label="Lat 2" />
          <input id="lon2" type="number" step="any" class="tool-input" value="8.6821" aria-label="Lon 2" />
        </div>
      </div>
      <div>
        <div class="kv-label">{T.delta}</div>
        <input id="delta-min" type="number" min="1" class="tool-input" value="15" aria-label={T.delta} />
      </div>
    </div>

    <button id="btn-calc" type="button" class="tool-btn">{T.btn}</button>
  </div>

  <div id="dist-result-card" class="tool-card">
    <h2>{T.h2Res}</h2>
    <div id="dist-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const lat1El = document.getElementById('lat1');
    const lon1El = document.getElementById('lon1');
    const lat2El = document.getElementById('lat2');
    const lon2El = document.getElementById('lon2');
    const minEl = document.getElementById('delta-min');
    const grid = document.getElementById('dist-grid');

    const PRESETS = {
      'sp-fra': { lat1: -23.5505, lon1: -46.6333, lat2: 50.1109, lon2: 8.6821, min: 15 },
      'sp-rj': { lat1: -23.5505, lon1: -46.6333, lat2: -22.9068, lon2: -43.1729, min: 45 },
      'ny-ldn': { lat1: 40.7128, lon1: -74.0060, lat2: 51.5074, lon2: -0.1278, min: 120 },
    };

    function haversineKm(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const toRad = (deg) => (deg * Math.PI) / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value;
      box.appendChild(l);
      box.appendChild(v);
      grid.appendChild(box);
    }

    function calculate() {
      const la1 = parseFloat(lat1El.value);
      const lo1 = parseFloat(lon1El.value);
      const la2 = parseFloat(lat2El.value);
      const lo2 = parseFloat(lon2El.value);
      const mins = Math.max(1, parseFloat(minEl.value) || 1);

      const km = haversineKm(la1, lo1, la2, lo2);
      const hours = mins / 60;
      const speed = km / hours;

      let verdict = L.plausible;
      if (speed > 950) verdict = L.impossible;
      else if (speed > 250) verdict = L.highSpeed;

      grid.innerHTML = '';
      addKv(L.dist, `${km.toFixed(1)} km (${(km * 0.621371).toFixed(1)} mi)`);
      addKv(L.speed, `${speed.toFixed(1)} km/h`);
      addKv(L.verdict, verdict);
    }

    document.getElementById('btn-calc')?.addEventListener('click', calculate);
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = PRESETS[btn.getAttribute('data-p')];
        if (!p) return;
        lat1El.value = p.lat1;
        lon1El.value = p.lon1;
        lat2El.value = p.lat2;
        lon2El.value = p.lon2;
        minEl.value = p.min;
        calculate();
      });
    });

    calculate();
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "calc-ops")!;
const T = {
  pt: { h2Sla: "1. Calculadora de SLA Uptime (Downtime Permitido)", btnSla: "Calcular Downtime", h2Bb: "2. Conversor de Bytes, Bits & Banda", btnBb: "Converter", h2Raid: "3. Calculadora de Capacidade RAID", btnRaid: "Calcular RAID" },
  de: { h2Sla: "1. SLA-Uptime-Rechner (Erlaubte Downtime)", btnSla: "Downtime berechnen", h2Bb: "2. Bytes-, Bits- & Bandbreiten-Konverter", btnBb: "Konvertieren", h2Raid: "3. RAID-Kapazitätsrechner", btnRaid: "RAID berechnen" },
  zh: { h2Sla: "1. SLA 可用性停机预算计算器", btnSla: "计算停机窗口", h2Bb: "2. 存储单位与带宽换算", btnBb: "换算", h2Raid: "3. RAID 容量规划计算器", btnRaid: "计算 RAID" },
  en: { h2Sla: "1. SLA Uptime Calculator (Allowed Downtime)", btnSla: "Calculate Downtime", h2Bb: "2. Bytes, Bits & Bandwidth Converter", btnBb: "Convert", h2Raid: "3. RAID Capacity Calculator", btnRaid: "Calculate RAID" },
}[locale];
const L = {
  pt: {
    secUnit: "seg", daily: "Diário", monthly: "Mensal (30d)", yearly: "Anual (365d)",
    r0: "0 discos (Sem redundância)", r1: "disco(s)", r5: "1 disco", r6: "2 discos", r10: "Até 1 disco por espelho",
    usable: "Capacidade Útil", raw: "Espaço Bruto Total", fault: "Tolerância a Falhas",
  },
  de: {
    secUnit: "Sek.", daily: "Täglich", monthly: "Monatlich (30T)", yearly: "Jährlich (365T)",
    r0: "0 Festplatten (Keine Redundanz)", r1: "Festplatte(n)", r5: "1 Festplatte", r6: "2 Festplatten", r10: "Bis zu 1 Platte pro Mirror",
    usable: "Nutzbare Kapazität", raw: "Brutto-Speicherplatz", fault: "Fehlertoleranz",
  },
  zh: {
    secUnit: "秒", daily: "每日", monthly: "每月 (30天)", yearly: "每年 (365天)",
    r0: "0 块盘（无冗余）", r1: "块盘", r5: "1 块盘", r6: "2 块盘", r10: "每组镜像最多允许坏 1 块盘",
    usable: "可用容量", raw: "总原始容量", fault: "容错能力",
  },
  en: {
    secUnit: "sec", daily: "Daily", monthly: "Monthly (30d)", yearly: "Yearly (365d)",
    r0: "0 disks (No redundancy)", r1: "disk(s)", r5: "1 disk", r6: "2 disks", r10: "Up to 1 disk per mirror",
    usable: "Usable Capacity", raw: "Total Raw Space", fault: "Fault Tolerance",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Infra & Ops"
  icon="📊"
>
  <!-- 1. SLA Uptime -->
  <div class="tool-card">
    <h2>{T.h2Sla}</h2>
    <div class="tool-form-row" style="margin-bottom:.85rem;">
      <input id="sla-pct" type="number" step="0.001" min="0" max="100" value="99.95" class="tool-input" aria-label="SLA %" />
      <button id="btn-sla" type="button" class="tool-btn">{T.btnSla}</button>
    </div>
    <div id="sla-grid" class="tool-grid"></div>
  </div>

  <!-- 2. Bytes & Bits -->
  <div class="tool-card">
    <h2>{T.h2Bb}</h2>
    <div class="tool-form-row" style="margin-bottom:.85rem;">
      <input id="bb-val" type="number" step="any" value="100" class="tool-input" aria-label="Value" />
      <select id="bb-unit" class="tool-select" style="max-width:160px;" aria-label="Unit">
        <option value="MB">Megabytes (MB)</option>
        <option value="GB" selected>Gigabytes (GB)</option>
        <option value="TB">Terabytes (TB)</option>
        <option value="Mbps">Megabits/s (Mbps)</option>
      </select>
      <button id="btn-bb" type="button" class="tool-btn">{T.btnBb}</button>
    </div>
    <div id="bb-grid" class="tool-grid"></div>
  </div>

  <!-- 3. RAID Calculator -->
  <div class="tool-card">
    <h2>{T.h2Raid}</h2>
    <div class="tool-form-row" style="margin-bottom:.85rem;">
      <select id="raid-level" class="tool-select" style="max-width:160px;" aria-label="RAID">
        <option value="0">RAID 0</option>
        <option value="1">RAID 1</option>
        <option value="5" selected>RAID 5</option>
        <option value="6">RAID 6</option>
        <option value="10">RAID 10</option>
      </select>
      <input id="raid-disks" type="number" min="2" max="64" value="4" class="tool-input" placeholder="Disks" aria-label="Disks" />
      <input id="raid-size" type="number" min="1" value="4" class="tool-input" placeholder="TB" aria-label="TB" />
      <button id="btn-raid" type="button" class="tool-btn">{T.btnRaid}</button>
    </div>
    <div id="raid-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    function addKv(container, label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value}</div>`;
      container.appendChild(box);
    }

    function fmtSec(sec) {
      if (sec < 60) return `${sec.toFixed(1)} ${L.secUnit}`;
      const m = Math.floor(sec / 60);
      const s = Math.round(sec % 60);
      if (m < 60) return `${m}m ${s}s`;
      const h = Math.floor(m / 60);
      const rm = m % 60;
      return `${h}h ${rm}m`;
    }

    // 1. SLA
    const slaPct = document.getElementById('sla-pct');
    const slaGrid = document.getElementById('sla-grid');
    function calcSla() {
      const pct = Math.min(100, Math.max(0, parseFloat(slaPct.value) || 0));
      const down = (100 - pct) / 100;
      slaGrid.innerHTML = '';
      addKv(slaGrid, L.daily, fmtSec(86400 * down));
      addKv(slaGrid, L.monthly, fmtSec(2592000 * down));
      addKv(slaGrid, L.yearly, fmtSec(31536000 * down));
    }
    document.getElementById('btn-sla')?.addEventListener('click', calcSla);
    calcSla();

    // 2. Bytes/Bits
    const bbVal = document.getElementById('bb-val');
    const bbUnit = document.getElementById('bb-unit');
    const bbGrid = document.getElementById('bb-grid');
    function calcBb() {
      const v = parseFloat(bbVal.value) || 0;
      const u = bbUnit.value;
      let bytes = 0;
      if (u === 'MB') bytes = v * 1e6;
      else if (u === 'GB') bytes = v * 1e9;
      else if (u === 'TB') bytes = v * 1e12;
      else if (u === 'Mbps') bytes = (v * 1e6) / 8;

      bbGrid.innerHTML = '';
      addKv(bbGrid, 'Megabytes (MB)', (bytes / 1e6).toFixed(2));
      addKv(bbGrid, 'Gigabytes (GB)', (bytes / 1e9).toFixed(4));
      addKv(bbGrid, 'Gibibytes (GiB)', (bytes / Math.pow(1024, 3)).toFixed(4));
      addKv(bbGrid, 'Megabits (Mb)', ((bytes * 8) / 1e6).toFixed(2));
    }
    document.getElementById('btn-bb')?.addEventListener('click', calcBb);
    bbUnit?.addEventListener('change', calcBb);
    calcBb();

    // 3. RAID
    const raidLevel = document.getElementById('raid-level');
    const raidDisks = document.getElementById('raid-disks');
    const raidSize = document.getElementById('raid-size');
    const raidGrid = document.getElementById('raid-grid');
    function calcRaid() {
      const lvl = raidLevel.value;
      const n = Math.max(2, parseInt(raidDisks.value, 10) || 2);
      const sz = Math.max(1, parseFloat(raidSize.value) || 1);
      let usable = 0;
      let fault = '';
      if (lvl === '0') { usable = n * sz; fault = L.r0; }
      else if (lvl === '1') { usable = sz; fault = `${n - 1} ${L.r1}`; }
      else if (lvl === '5') { usable = Math.max(0, (n - 1) * sz); fault = L.r5; }
      else if (lvl === '6') { usable = Math.max(0, (n - 2) * sz); fault = L.r6; }
      else if (lvl === '10') { usable = Math.floor(n / 2) * sz; fault = L.r10; }

      raidGrid.innerHTML = '';
      addKv(raidGrid, L.usable, `${usable.toFixed(1)} TB`);
      addKv(raidGrid, L.raw, `${(n * sz).toFixed(1)} TB`);
      addKv(raidGrid, L.fault, fault);
    }
    document.getElementById('btn-raid')?.addEventListener('click', calcRaid);
    raidLevel?.addEventListener('change', calcRaid);
    calcRaid();
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "ipv4-ipv6")!;
const T = {
  pt: { h2v4: "1. Conversor IPv4 ↔ Decimal / Binário / IPv6", btnV4: "Converter", h2v6: "2. Expansor, Compressor & Gerador Local IPv6 (ULA)", btnV6: "Analisar IPv6", btnGen: "Gerar IPv6 Local (ULA fd00::/8)" },
  de: { h2v4: "1. IPv4 ↔ Dezimal / Binär / IPv6 Konverter", btnV4: "Konvertieren", h2v6: "2. IPv6 Expander, Kompressor & ULA-Generator", btnV6: "IPv6 analysieren", btnGen: "Lokale IPv6 (ULA fd00::/8) generieren" },
  zh: { h2v4: "1. IPv4 ↔ 十进制 / 二进制 / IPv6 转换器", btnV4: "转换", h2v6: "2. IPv6 展开、压缩与本地 ULA 生成器", btnV6: "解析 IPv6", btnGen: "生成本地 IPv6 (ULA fd00::/8)" },
  en: { h2v4: "1. IPv4 ↔ Decimal / Binary / IPv6 Converter", btnV4: "Convert", h2v6: "2. IPv6 Expander, Compressor & ULA Generator", btnV6: "Analyze IPv6", btnGen: "Generate Local IPv6 (ULA fd00::/8)" },
}[locale];
const L = {
  pt: {
    invalidV4: "Informe um IPv4 válido (ex: 192.0.2.10) ou inteiro decimal de 32 bits.",
    stdV4: "IPv4 Padrão", dec: "Decimal (32-bit)", hex: "Hexadecimal", bin: "Binário",
    mapped: "IPv4-mapped IPv6", mappedHex: "IPv4-mapped (Hex)", six4: "6to4 IPv6",
    doneV4: "Conversão IPv4 concluída.",
    invalidV6: "Endereço IPv6 inválido.",
    v6Exp: "Forma Expandida (128-bit)", v6Comp: "Forma Comprimida (RFC 5952)", rdns: "DNS Reverso (PTR)",
    doneV6: "Análise IPv6 concluída.",
  },
  de: {
    invalidV4: "Geben Sie eine gültige IPv4 (z. B. 192.0.2.10) oder eine 32-Bit-Dezimalzahl ein.",
    stdV4: "Standard-IPv4", dec: "Dezimal (32-Bit)", hex: "Hexadezimal", bin: "Binär",
    mapped: "IPv4-mapped IPv6", mappedHex: "IPv4-mapped (Hex)", six4: "6to4 IPv6",
    doneV4: "IPv4-Konvertierung abgeschlossen.",
    invalidV6: "Ungültige IPv6-Adresse.",
    v6Exp: "Erweiterte Form (128-Bit)", v6Comp: "Komprimierte Form (RFC 5952)", rdns: "Reverse-DNS (PTR)",
    doneV6: "IPv6-Analyse abgeschlossen.",
  },
  zh: {
    invalidV4: "请输入有效的 IPv4 地址（如 192.0.2.10）或 32 位十进制整数。",
    stdV4: "标准 IPv4", dec: "十进制 (32-bit)", hex: "十六进制", bin: "二进制",
    mapped: "IPv4 映射 IPv6", mappedHex: "IPv4 映射 (十六进制)", six4: "6to4 IPv6",
    doneV4: "IPv4 转换完成。",
    invalidV6: "无效的 IPv6 地址。",
    v6Exp: "完整展开形式 (128-bit)", v6Comp: "压缩形式 (RFC 5952)", rdns: "反向 DNS (PTR)",
    doneV6: "IPv6 解析完成。",
  },
  en: {
    invalidV4: "Enter a valid IPv4 (e.g., 192.0.2.10) or 32-bit decimal integer.",
    stdV4: "Standard IPv4", dec: "Decimal (32-bit)", hex: "Hexadecimal", bin: "Binary",
    mapped: "IPv4-mapped IPv6", mappedHex: "IPv4-mapped (Hex)", six4: "6to4 IPv6",
    doneV4: "IPv4 conversion completed.",
    invalidV6: "Invalid IPv6 address.",
    v6Exp: "Expanded Form (128-bit)", v6Comp: "Compressed Form (RFC 5952)", rdns: "Reverse DNS (PTR)",
    doneV6: "IPv6 analysis completed.",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="IPv4 / IPv6"
  icon="🔄"
>
  <div class="tool-card">
    <h2>{T.h2v4}</h2>
    <div class="tool-form-row">
      <input id="v4-in" type="text" class="tool-input" value="192.0.2.10" placeholder="192.0.2.10" aria-label="IPv4" />
      <button id="btn-v4" type="button" class="tool-btn">{T.btnV4}</button>
    </div>
    <p id="v4-status" class="status-msg"></p>
    <div id="v4-grid" class="tool-grid" style="margin-top:.85rem;"></div>
  </div>

  <div class="tool-card">
    <h2>{T.h2v6}</h2>
    <div class="tool-form-row">
      <input id="v6-in" type="text" class="tool-input" value="2001:db8::1" placeholder="2001:db8::1" aria-label="IPv6" />
      <button id="btn-v6" type="button" class="tool-btn">{T.btnV6}</button>
      <button id="btn-v6-gen" type="button" class="tool-btn secondary">{T.btnGen}</button>
    </div>
    <p id="v6-status" class="status-msg"></p>
    <div id="v6-grid" class="tool-grid" style="margin-top:.85rem;"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const v4In = document.getElementById('v4-in');
    const v4Grid = document.getElementById('v4-grid');
    const v4Status = document.getElementById('v4-status');

    const v6In = document.getElementById('v6-in');
    const v6Grid = document.getElementById('v6-grid');
    const v6Status = document.getElementById('v6-status');

    function addKv(container, label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value}</div>`;
      container.appendChild(box);
    }

    function convertV4() {
      const raw = v4In.value.trim();
      v4Grid.innerHTML = '';
      let parts = null;

      if (/^\d+$/.test(raw)) {
        const n = Number(raw);
        if (n >= 0 && n <= 4294967295) {
          parts = [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255];
        }
      } else if (/^(\d{1,3}\.){3}\d{1,3}$/.test(raw)) {
        const p = raw.split('.').map(Number);
        if (p.every((x) => x >= 0 && x <= 255)) parts = p;
      }

      if (!parts) {
        v4Status.textContent = L.invalidV4;
        v4Status.className = 'status-msg error';
        return;
      }

      const ipStr = parts.join('.');
      const dec = ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
      const hexPairs = parts.map((x) => x.toString(16).padStart(2, '0'));
      const binOctets = parts.map((x) => x.toString(2).padStart(8, '0')).join('.');
      const mapped = `::ffff:${ipStr}`;
      const mappedHex = `::ffff:${hexPairs[0]}${hexPairs[1]}:${hexPairs[2]}${hexPairs[3]}`;
      const sixToFour = `2002:${hexPairs[0]}${hexPairs[1]}:${hexPairs[2]}${hexPairs[3]}::`;

      addKv(v4Grid, L.stdV4, ipStr);
      addKv(v4Grid, L.dec, String(dec));
      addKv(v4Grid, L.hex, `0x${dec.toString(16).padStart(8, '0')}`);
      addKv(v4Grid, L.bin, binOctets);
      addKv(v4Grid, L.mapped, mapped);
      addKv(v4Grid, L.mappedHex, mappedHex);
      addKv(v4Grid, L.six4, sixToFour);

      v4Status.textContent = L.doneV4;
      v4Status.className = 'status-msg ok';
    }

    function expandIPv6(ip) {
      const halves = ip.split('::');
      if (halves.length > 2) return null;
      const left = halves[0] ? halves[0].split(':') : [];
      const right = halves[1] ? halves[1].split(':') : [];
      const missing = 8 - (left.length + right.length);
      if (missing < 0) return null;
      const full = [...left, ...Array(missing).fill('0'), ...right];
      if (full.length !== 8 || !full.every((h) => /^[0-9a-fA-F]{1,4}$/.test(h))) return null;
      return full.map((h) => h.padStart(4, '0').toLowerCase()).join(':');
    }

    function compressIPv6(expanded) {
      const groups = expanded.split(':').map((g) => g.replace(/^0+/, '') || '0');
      let bestStart = -1, bestLen = 0, curStart = -1, curLen = 0;
      groups.forEach((g, i) => {
        if (g === '0') {
          if (curStart === -1) curStart = i;
          curLen++;
          if (curLen > bestLen) { bestStart = curStart; bestLen = curLen; }
        } else {
          curStart = -1; curLen = 0;
        }
      });
      if (bestLen > 1) {
        groups.splice(bestStart, bestLen, '');
        if (bestStart === 0) groups.unshift('');
        if (bestStart + bestLen === 8) groups.push('');
      }
      return groups.join(':').replace(/:{3,}/g, '::');
    }

    function analyzeV6() {
      const raw = v6In.value.trim().split('/')[0];
      v6Grid.innerHTML = '';
      const exp = expandIPv6(raw);
      if (!exp) {
        v6Status.textContent = L.invalidV6;
        v6Status.className = 'status-msg error';
        return;
      }
      const comp = compressIPv6(exp);
      const ptr = exp.replace(/:/g, '').split('').reverse().join('.') + '.ip6.arpa';
      addKv(v6Grid, L.v6Exp, exp);
      addKv(v6Grid, L.v6Comp, comp);
      addKv(v6Grid, L.rdns, ptr);
      v6Status.textContent = L.doneV6;
      v6Status.className = 'status-msg ok';
    }

    document.getElementById('btn-v4')?.addEventListener('click', convertV4);
    document.getElementById('btn-v6')?.addEventListener('click', analyzeV6);
    document.getElementById('btn-v6-gen')?.addEventListener('click', () => {
      const bytes = new Uint8Array(15);
      crypto.getRandomValues(bytes);
      const hex = (i) => bytes[i].toString(16).padStart(2, '0');
      const ula = `fd${hex(0)}:${hex(1)}${hex(2)}:${hex(3)}${hex(4)}:${hex(5)}${hex(6)}:${hex(7)}${hex(8)}:${hex(9)}${hex(10)}:${hex(11)}${hex(12)}:${hex(13)}${hex(14)}`;
      v6In.value = ula;
      analyzeV6();
    });

    convertV4();
    analyzeV6();
  })();
</script>


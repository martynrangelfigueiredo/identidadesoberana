---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "email-headers")!;
const T = {
  pt: { h2: "Cole os Cabeçalhos Brutos do E-mail", btn: "Analisar Cabeçalhos", h2Sum: "Resumo de Autenticação & Spoofing", h2Hops: "Rota de Entrega (Saltos Received) & IPs Encontrados" },
  de: { h2: "Rohe E-Mail-Header einfügen", btn: "Header analysieren", h2Sum: "Authentifizierungs- & Spoofing-Zusammenfassung", h2Hops: "Zustellroute (Received-Hops) & gefundene IPs" },
  zh: { h2: "粘贴原始邮件头信息", btn: "解析邮件头", h2Sum: "认证状态与伪造检测摘要", h2Hops: "传输路径（Received 跳数）与提取 IP" },
  en: { h2: "Paste Raw Email Headers", btn: "Analyze Headers", h2Sum: "Authentication & Spoofing Summary", h2Hops: "Delivery Route (Received Hops) & Extracted IPs" },
}[locale];
const L = {
  pt: {
    subj: "Assunto (Subject)", from: "Remetente (From)", ret: "Return-Path (Envelope)",
    sameFrom: "Mesmo que From", notFound: "Não encontrado", origIp: "IP de Origem (Header)",
    totalHops: "Total de saltos (Received):", ipsExt: "IPs IPv4 extraídos:", none: "Nenhum", hop: "Salto",
  },
  de: {
    subj: "Betreff (Subject)", from: "Absender (From)", ret: "Return-Path (Envelope)",
    sameFrom: "Wie From", notFound: "Nicht gefunden", origIp: "Quell-IP (Header)",
    totalHops: "Gesamte Hops (Received):", ipsExt: "Extrahierte IPv4-Adressen:", none: "Keine", hop: "Hop",
  },
  zh: {
    subj: "主题 (Subject)", from: "发件人 (From)", ret: "Return-Path (信封地址)",
    sameFrom: "与 From 相同", notFound: "未找到", origIp: "源 IP (Header)",
    totalHops: "总跳数 (Received):", ipsExt: "提取的 IPv4 地址:", none: "无", hop: "跳",
  },
  en: {
    subj: "Subject", from: "Sender (From)", ret: "Return-Path (Envelope)",
    sameFrom: "Same as From", notFound: "Not found", origIp: "Originating IP (Header)",
    totalHops: "Total hops (Received):", ipsExt: "Extracted IPv4 IPs:", none: "None", hop: "Hop",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Email & SOC"
  icon="✉️"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <textarea
      id="hdr-input"
      class="tool-textarea"
      rows="6"
      placeholder="From:, Return-Path:, Authentication-Results:, Received:, Message-ID:..."
      aria-label={T.h2}
    ></textarea>
    <div style="margin-top:.75rem;">
      <button id="btn-hdr" type="button" class="tool-btn">{T.btn}</button>
    </div>
  </div>

  <div id="hdr-summary-card" class="tool-card" style="display:none;">
    <h2>{T.h2Sum}</h2>
    <div id="hdr-grid" class="tool-grid"></div>
  </div>

  <div id="hdr-hops-card" class="tool-card" style="display:none;">
    <h2>{T.h2Hops}</h2>
    <pre id="hdr-hops" class="code-out"></pre>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const input = document.getElementById('hdr-input');
    const summaryCard = document.getElementById('hdr-summary-card');
    const grid = document.getElementById('hdr-grid');
    const hopsCard = document.getElementById('hdr-hops-card');
    const hopsOut = document.getElementById('hdr-hops');

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value || '—'}</div>`;
      grid.appendChild(box);
    }

    function unfoldHeaders(raw) {
      return raw.replace(/\r?\n[ \t]+/g, ' ');
    }

    function getHeader(unfolded, name) {
      const rx = new RegExp(`^${name}:\\s*(.+)$`, 'im');
      const m = unfolded.match(rx);
      return m ? m[1].trim() : '';
    }

    function analyze() {
      const raw = input.value.trim();
      if (!raw) return;

      const unfolded = unfoldHeaders(raw);
      const from = getHeader(unfolded, 'From');
      const returnPath = getHeader(unfolded, 'Return-Path');
      const replyTo = getHeader(unfolded, 'Reply-To');
      const subject = getHeader(unfolded, 'Subject');
      const authRes = getHeader(unfolded, 'Authentication-Results');
      const origIp = getHeader(unfolded, 'X-Originating-IP') || getHeader(unfolded, 'X-Sender-IP');

      const spfMatch = authRes.match(/spf=(\w+)/i);
      const dkimMatch = authRes.match(/dkim=(\w+)/i);
      const dmarcMatch = authRes.match(/dmarc=(\w+)/i);

      const receivedLines = unfolded
        .split(/\r?\n/)
        .filter((l) => /^Received:/i.test(l))
        .reverse();

      const ips = [...new Set(unfolded.match(/\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\b/g) || [])];

      grid.innerHTML = '';
      addKv(L.subj, subject || '—');
      addKv(L.from, from || '—');
      addKv(L.ret, returnPath || '—');
      addKv('Reply-To', replyTo || L.sameFrom);
      addKv('SPF', spfMatch ? spfMatch[1].toUpperCase() : L.notFound);
      addKv('DKIM', dkimMatch ? dkimMatch[1].toUpperCase() : L.notFound);
      addKv('DMARC', dmarcMatch ? dmarcMatch[1].toUpperCase() : L.notFound);
      addKv(L.origIp, origIp || (ips[0] || '—'));

      summaryCard.style.display = '';
      hopsCard.style.display = '';
      hopsOut.textContent =
        `${L.totalHops} ${receivedLines.length}\n` +
        `${L.ipsExt} ${ips.join(', ') || L.none}\n\n` +
        receivedLines.map((line, i) => `[${L.hop} ${i + 1}] ${line}`).join('\n\n');
    }

    document.getElementById('btn-hdr')?.addEventListener('click', analyze);
  })();
</script>


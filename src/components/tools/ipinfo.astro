---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge={T.badge}
  icon="🌐"
>
  <div class="tool-card">
    <h2>{T.h2Search}</h2>
    <div class="tool-form-row">
      <input
        id="ip-input"
        type="text"
        class="tool-input"
        placeholder={T.ph}
        aria-label={T.h2Search}
      />
      <button id="btn-lookup" type="button" class="tool-btn">{T.btnLookup}</button>
      <button id="btn-myip" type="button" class="tool-btn secondary">{T.btnMyIp}</button>
    </div>
    <p id="ip-status" class="status-msg" style="color:var(--is-cinza);">
      {T.hint}
    </p>
  </div>

  <!-- Bloco 1: Análise Técnica Local (Instantânea, 0ms) -->
  <div id="local-analysis-card" class="tool-card" style="display:none;">
    <h2>{T.h2Local}</h2>
    <div id="local-grid" class="tool-grid"></div>
  </div>

  <!-- Bloco 2: Resumo Consolidado + Mapa Sob Demanda -->
  <div id="geo-card" class="tool-card" style="display:none;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem;">
      <h2 style="margin:0;">{T.h2Geo}</h2>
      <button id="btn-load-map" type="button" class="tool-btn outline" style="display:none;">{T.btnMap}</button>
    </div>
    <div id="geo-grid" class="tool-grid"></div>
    <div id="map-container" style="display:none;margin-top:1rem;border-radius:12px;overflow:hidden;border:1px solid var(--is-borda);">
      <iframe
        id="osm-frame"
        title="OpenStreetMap"
        width="100%"
        height="300"
        style="border:0;display:block;"
        loading="lazy"
      ></iframe>
    </div>
  </div>

  <!-- Bloco 3: Comparação Multi-Provedor -->
  <div id="multi-card" class="tool-card" style="display:none;overflow-x:auto;">
    <h2>{T.h2Multi}</h2>
    <table style="width:100%;border-collapse:collapse;font-size:.9rem;">
      <thead>
        <tr style="border-bottom:2px solid var(--is-borda);text-align:left;">
          <th style="padding:.55rem;">{T.thSource}</th>
          <th style="padding:.55rem;">{T.thLoc}</th>
          <th style="padding:.55rem;">{T.thOrg}</th>
          <th style="padding:.55rem;">{T.thSig}</th>
        </tr>
      </thead>
      <tbody id="multi-tbody"></tbody>
    </table>
  </div>

  <!-- Bloco 4: Registro RDAP (RIR Regional: LACNIC, APNIC, ARIN, RIPE) -->
  <div id="rdap-card" class="tool-card" style="display:none;">
    <h2>{T.h2Rdap}</h2>
    <div id="rdap-grid" class="tool-grid"></div>
  </div>

  <!-- Bloco 5: Queries SOC (Empilhadas) & Pivot Regional/Global -->
  <div id="pivot-card" class="tool-card" style="display:none;">
    <h2>{T.h2Pivot}</h2>

    <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.25rem;">
      <div>
        <div class="kv-label" style="margin-bottom:.35rem;">KQL — Microsoft Sentinel / Entra ID (SigninLogs)</div>
        <pre id="kql-out" class="code-out"></pre>
      </div>
      <div>
        <div class="kv-label" style="margin-bottom:.35rem;">Wazuh / OpenSearch (Lucene)</div>
        <pre id="wazuh-out" class="code-out"></pre>
      </div>
    </div>

    <div class="kv-label">{T.lblPivot}</div>
    <div id="pivot-links" class="pivot-bar"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const ipInput = document.getElementById('ip-input');
    const btnLookup = document.getElementById('btn-lookup');
    const btnMyIp = document.getElementById('btn-myip');
    const statusEl = document.getElementById('ip-status');

    const localCard = document.getElementById('local-analysis-card');
    const localGrid = document.getElementById('local-grid');
    const geoCard = document.getElementById('geo-card');
    const geoGrid = document.getElementById('geo-grid');
    const btnLoadMap = document.getElementById('btn-load-map');
    const mapContainer = document.getElementById('map-container');
    const osmFrame = document.getElementById('osm-frame');

    const multiCard = document.getElementById('multi-card');
    const multiTbody = document.getElementById('multi-tbody');

    const rdapCard = document.getElementById('rdap-card');
    const rdapGrid = document.getElementById('rdap-grid');

    const pivotCard = document.getElementById('pivot-card');
    const kqlOut = document.getElementById('kql-out');
    const wazuhOut = document.getElementById('wazuh-out');
    const pivotLinks = document.getElementById('pivot-links');

    let activeReqId = 0;
    let activeAbort = null;
    let pendingCoords = null;

    function addKv(container, label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value || '—';
      box.appendChild(l);
      box.appendChild(v);
      container.appendChild(box);
    }

    function addMultiRow(source, location, org, signal) {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--is-borda)';
      tr.innerHTML = `
        <td style="padding:.55rem;font-weight:700;color:var(--is-verde-escuro);">${source}</td>
        <td style="padding:.55rem;">${location || '—'}</td>
        <td style="padding:.55rem;">${org || '—'}</td>
        <td style="padding:.55rem;font-family:var(--is-fonte-mono);font-size:.82rem;">${signal || '—'}</td>
      `;
      multiTbody.appendChild(tr);
    }

    function isIPv4(ip) {
      const parts = ip.split('.');
      if (parts.length !== 4) return false;
      return parts.every((p) => /^\d+$/.test(p) && Number(p) >= 0 && Number(p) <= 255);
    }

    function isIPv6(ip) {
      return ip.includes(':') && /^[0-9a-fA-F:]+$/.test(ip);
    }

    function expandIPv6(ip) {
      if (!ip.includes(':')) return ip;
      const halves = ip.split('::');
      if (halves.length > 2) return L.invalidIp;
      const left = halves[0] ? halves[0].split(':') : [];
      const right = halves[1] ? halves[1].split(':') : [];
      const missing = 8 - (left.length + right.length);
      if (missing < 0) return L.invalidIp;
      const full = [...left, ...Array(missing).fill('0'), ...right];
      return full.map((h) => h.padStart(4, '0').toLowerCase()).join(':');
    }

    function compressIPv6(expanded) {
      return expanded
        .split(':')
        .map((g) => g.replace(/^0+/, '') || '0')
        .join(':')
        .replace(/(^|:)(0:){2,}/, '::')
        .replace(/^0::/, '::');
    }

    function classifyIPv4(ip) {
      const [a, b, c] = ip.split('.').map(Number);
      if (a === 10) return L.privRfc;
      if (a === 172 && b >= 16 && b <= 31) return L.privRfc;
      if (a === 192 && b === 168) return L.privRfc;
      if (a === 127) return `${L.loopback} (127.0.0.0/8)`;
      if (a === 169 && b === 254) return `${L.linkLocal} / Cloud Metadata`;
      if (a === 100 && b >= 64 && b <= 127) return L.cgnat;
      if (a === 192 && b === 0 && c === 2) return `${L.docRange} (TEST-NET-1)`;
      if (a === 198 && b === 51 && c === 100) return `${L.docRange} (TEST-NET-2)`;
      if (a === 203 && b === 0 && c === 113) return `${L.docRange} (TEST-NET-3)`;
      return L.pubIp;
    }

    function classifyIPv6(expanded) {
      if (expanded === '0000:0000:0000:0000:0000:0000:0000:0001') return `${L.loopback} (::1)`;
      if (expanded.startsWith('fe80:')) return `${L.linkLocal} (fe80::/10)`;
      if (expanded.startsWith('fc') || expanded.startsWith('fd')) return 'ULA Private (fc00::/7)';
      if (expanded.startsWith('2001:0db8:')) return `${L.docRange} (RFC 3849)`;
      if (expanded.startsWith('ff')) return 'Multicast (ff00::/8)';
      return L.pubV6;
    }

    function calcIPv4Cidr(ip, prefix) {
      const p = Number(prefix);
      if (isNaN(p) || p < 0 || p > 32) return null;
      const parts = ip.split('.').map(Number);
      const ipInt = ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
      const mask = p === 0 ? 0 : (0xffffffff << (32 - p)) >>> 0;
      const net = (ipInt & mask) >>> 0;
      const bcast = (net | (~mask >>> 0)) >>> 0;
      const toStr = (n) => [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
      const total = Math.pow(2, 32 - p);
      return {
        mask: toStr(mask),
        network: toStr(net),
        broadcast: toStr(bcast),
        hosts: p >= 31 ? total : Math.max(0, total - 2),
      };
    }

    function detectCloud(org) {
      const s = (org || '').toLowerCase();
      if (s.includes('microsoft') || s.includes('azure')) return 'Microsoft Azure';
      if (s.includes('amazon') || s.includes('aws')) return 'Amazon AWS';
      if (s.includes('google')) return 'Google Cloud';
      if (s.includes('cloudflare')) return 'Cloudflare';
      if (s.includes('digitalocean')) return 'DigitalOcean';
      if (s.includes('oracle')) return 'Oracle Cloud';
      if (s.includes('alibaba') || s.includes('tencent')) return 'Alibaba / Tencent Cloud';
      if (s.includes('ovh') || s.includes('hetzner')) return 'OVH / Hetzner';
      return 'ISP / Enterprise';
    }

    function fetchWithTimeout(url, opts = {}, signal, ms = 4500) {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), ms);
      if (signal) {
        signal.addEventListener('abort', () => ctrl.abort(), { once: true });
      }
      return fetch(url, { ...opts, signal: ctrl.signal }).finally(() => clearTimeout(timer));
    }

    function renderLocalAnalysis(baseIp, cidrPrefix) {
      localGrid.innerHTML = '';
      localCard.style.display = '';
      if (isIPv4(baseIp)) {
        addKv(localGrid, L.protoVer, 'IPv4');
        addKv(localGrid, L.scope, classifyIPv4(baseIp));
        if (cidrPrefix !== undefined) {
          const cidr = calcIPv4Cidr(baseIp, cidrPrefix);
          if (cidr) {
            addKv(localGrid, L.mask, cidr.mask);
            addKv(localGrid, L.netAddr, cidr.network);
            addKv(localGrid, L.bcast, cidr.broadcast);
            addKv(localGrid, L.hosts, String(cidr.hosts));
          }
        }
      } else if (isIPv6(baseIp)) {
        const exp = expandIPv6(baseIp);
        addKv(localGrid, L.protoVer, 'IPv6');
        addKv(localGrid, L.v6Exp, exp);
        addKv(localGrid, L.v6Comp, compressIPv6(exp));
        addKv(localGrid, L.scope, classifyIPv6(exp));
      }
    }

    function renderPivots(targetIp) {
      pivotCard.style.display = '';
      kqlOut.textContent = `SigninLogs\n| where IPAddress == "${targetIp}"\n| project TimeGenerated, UserPrincipalName, AppDisplayName, Location, ResultType`;
      wazuhOut.textContent = `data.srcip: "${targetIp}" OR data.win.eventdata.ipAddress: "${targetIp}"`;

      const links = [
        { name: 'IP2Location', url: `https://www.ip2location.com/demo/${encodeURIComponent(targetIp)}` },
        { name: 'DB-IP', url: `https://db-ip.com/${encodeURIComponent(targetIp)}` },
        { name: 'CriminalIP', url: `https://www.criminalip.io/asset/report/${encodeURIComponent(targetIp)}` },
        { name: 'IPinfo.io', url: `https://ipinfo.io/${encodeURIComponent(targetIp)}` },
        { name: 'iplocation.io', url: `https://iplocation.io/ip/${encodeURIComponent(targetIp)}` },
        { name: 'LACNIC (LATAM)', url: `https://rdap.lacnic.net/rdap/ip/${encodeURIComponent(targetIp)}` },
        { name: 'Registro.br (BR)', url: `https://registro.br/tecnologia/ferramentas/whois/?search=${encodeURIComponent(targetIp)}` },
        { name: 'APNIC (APAC)', url: `https://wq.apnic.net/static/search.html?query=${encodeURIComponent(targetIp)}` },
        { name: 'ThreatBook (APAC CTI)', url: `https://threatbook.io/ip/${encodeURIComponent(targetIp)}` },
        { name: 'AbuseIPDB', url: `https://www.abuseipdb.com/check/${encodeURIComponent(targetIp)}` },
        { name: 'Shodan', url: `https://www.shodan.io/host/${encodeURIComponent(targetIp)}` },
        { name: 'Cisco Talos', url: `https://talosintelligence.com/reputation_center/lookup?search=${encodeURIComponent(targetIp)}` },
        { name: 'AlienVault OTX', url: `https://otx.alienvault.com/indicator/ip/${encodeURIComponent(targetIp)}` },
        { name: 'Spamhaus', url: `https://check.spamhaus.org/results/?query=${encodeURIComponent(targetIp)}` },
      ];
      pivotLinks.innerHTML = '';
      links.forEach((l) => {
        const a = document.createElement('a');
        a.href = l.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'pivot-link';
        a.textContent = `${l.name} ↗`;
        pivotLinks.appendChild(a);
      });
    }

    async function runLookup(targetIpRaw) {
      const input = (targetIpRaw || '').trim();
      const [baseIp, cidrPrefix] = input.split('/');

      if (!baseIp || (!isIPv4(baseIp) && !isIPv6(baseIp))) {
        statusEl.textContent = L.invalidIp;
        statusEl.className = 'status-msg error';
        return;
      }

      if (activeAbort) activeAbort.abort();
      activeAbort = new AbortController();
      const signal = activeAbort.signal;
      const reqId = ++activeReqId;

      // Limpar estado anterior imediatamente
      localGrid.innerHTML = '';
      geoGrid.innerHTML = '';
      multiTbody.innerHTML = '';
      rdapGrid.innerHTML = '';
      mapContainer.style.display = 'none';
      osmFrame.src = 'about:blank';
      btnLoadMap.style.display = 'none';
      pendingCoords = null;

      geoCard.style.display = 'none';
      multiCard.style.display = '';
      rdapCard.style.display = 'none';

      statusEl.textContent = `${L.querying} (${baseIp})...`;
      statusEl.className = 'status-msg';

      // Análise local e Pivots aparecem em 0ms
      renderLocalAnalysis(baseIp, cidrPrefix);
      renderPivots(baseIp);

      let geoPopulated = false;

      // 1. Provedor A: ipwho.is
      const p1 = fetchWithTimeout(`https://ipwho.is/${encodeURIComponent(baseIp)}`, {}, signal)
        .then((r) => r.json())
        .then((d) => {
          if (reqId !== activeReqId || !d.success) return;
          addMultiRow('ipwho.is', `${d.country || '—'} · ${d.city || '—'}`, `AS${d.connection?.asn || '?'} · ${d.connection?.isp || d.connection?.org || '—'}`, d.timezone?.id || 'OK');
          if (!geoPopulated) {
            geoPopulated = true;
            geoCard.style.display = '';
            addKv(geoGrid, L.ipAddr, d.ip);
            addKv(geoGrid, L.contCountry, `${d.continent || ''} · ${d.flag?.emoji || ''} ${d.country || ''} (${d.country_code || ''})`.trim());
            addKv(geoGrid, L.stateCity, `${d.region || '—'} · ${d.city || '—'}`);
            addKv(geoGrid, L.postal, d.postal || '—');
            addKv(geoGrid, L.asnIsp, `AS${d.connection?.asn || '—'} · ${d.connection?.isp || '—'}`);
            addKv(geoGrid, L.orgCloud, `${d.connection?.org || '—'} (${detectCloud(d.connection?.org || d.connection?.isp)})`);
            addKv(geoGrid, L.tz, d.timezone?.id ? `${d.timezone.id} (UTC ${d.timezone.utc})` : '—');
            addKv(geoGrid, L.coords, `${d.latitude}, ${d.longitude}`);
            if (typeof d.latitude === 'number' && typeof d.longitude === 'number') {
              pendingCoords = { lat: d.latitude, lon: d.longitude };
              btnLoadMap.style.display = '';
            }
          }
        })
        .catch(() => {});

      // 2. Provedor B: ipinfo.io
      const p2 = fetchWithTimeout(`https://ipinfo.io/${encodeURIComponent(baseIp)}/json`, {}, signal)
        .then((r) => r.json())
        .then((d) => {
          if (reqId !== activeReqId || d.bogon || d.error) return;
          addMultiRow('IPinfo.io', `${d.country || '—'} · ${d.city || '—'}`, d.org || '—', d.anycast ? 'Anycast' : (d.timezone || 'OK'));
          if (!geoPopulated && d.loc) {
            geoPopulated = true;
            geoCard.style.display = '';
            addKv(geoGrid, L.ipAddr, d.ip);
            addKv(geoGrid, L.contCountry, `${d.country} · ${d.region} · ${d.city}`);
            addKv(geoGrid, L.asnIsp, d.org || '—');
            addKv(geoGrid, L.rdns, d.hostname || '—');
            addKv(geoGrid, L.tz, d.timezone || '—');
            const [lat, lon] = d.loc.split(',').map(Number);
            if (!isNaN(lat) && !isNaN(lon)) {
              pendingCoords = { lat, lon };
              btnLoadMap.style.display = '';
            }
          }
        })
        .catch(() => {});

      // 3. Provedor C: FreeIPAPI (com sinal de Proxy/VPN)
      const p3 = fetchWithTimeout(`https://freeipapi.com/api/json/${encodeURIComponent(baseIp)}`, {}, signal)
        .then((r) => r.json())
        .then((d) => {
          if (reqId !== activeReqId || !d.ipAddress) return;
          const sig = d.isProxy ? L.proxyYes : L.proxyNo;
          addMultiRow('FreeIPAPI', `${d.countryName || '—'} · ${d.cityName || '—'}`, d.asnOrganization || (d.asn ? `AS${d.asn}` : '—'), sig);
        })
        .catch(() => {});

      // 4. Provedor D: ipapi.co
      const p4 = fetchWithTimeout(`https://ipapi.co/${encodeURIComponent(baseIp)}/json/`, {}, signal)
        .then((r) => r.json())
        .then((d) => {
          if (reqId !== activeReqId || d.error) return;
          addMultiRow('ipapi.co', `${d.country_name || '—'} · ${d.city || '—'}`, `${d.asn || ''} · ${d.org || '—'}`, d.network || 'OK');
        })
        .catch(() => {});

      // 5. Reverse DNS (Cloudflare DoH PTR)
      let ptrName = '';
      if (isIPv4(baseIp)) ptrName = baseIp.split('.').reverse().join('.') + '.in-addr.arpa';
      else if (isIPv6(baseIp)) ptrName = expandIPv6(baseIp).replace(/:/g, '').split('').reverse().join('.') + '.ip6.arpa';

      const p5 = ptrName
        ? fetchWithTimeout(`https://cloudflare-dns.com/dns-query?name=${ptrName}&type=PTR`, { headers: { Accept: 'application/dns-json' } }, signal)
            .then((r) => r.json())
            .then((d) => {
              if (reqId !== activeReqId) return;
              const ptr = d.Answer?.[0]?.data?.replace(/\.$/, '') || L.noPtr;
              addKv(localGrid, L.rdns, ptr);
            })
            .catch(() => {})
        : Promise.resolve();

      // 6. RDAP (RIR Regional: LACNIC / APNIC / ARIN / RIPE)
      const p6 = fetchWithTimeout(`https://rdap.org/ip/${encodeURIComponent(baseIp)}`, {}, signal, 6000)
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (reqId !== activeReqId || !data) return;
          const emails = [];
          const walk = (ents) => {
            (ents || []).forEach((e) => {
              (e.vcardArray?.[1] || []).forEach((f) => {
                if (f[0] === 'email' && f[3]) emails.push(f[3]);
              });
              if (e.entities) walk(e.entities);
            });
          };
          walk(data.entities);
          const cidr = data.cidr0_cidrs?.[0]
            ? `${data.cidr0_cidrs[0].v4prefix || data.cidr0_cidrs[0].v6prefix}/${data.cidr0_cidrs[0].length}`
            : data.handle;

          rdapCard.style.display = '';
          addKv(rdapGrid, L.netName, data.name || '—');
          addKv(rdapGrid, L.cidrBlock, cidr || '—');
          addKv(rdapGrid, L.handle, data.handle || '—');
          addKv(rdapGrid, L.rir, data.port43 || '—');
          addKv(rdapGrid, L.abuse, [...new Set(emails)].join(', ') || L.noAbuse);
        })
        .catch(() => {});

      await Promise.allSettled([p1, p2, p3, p4, p5, p6]);
      if (reqId !== activeReqId) return;

      statusEl.textContent = `${L.done} (${baseIp})`;
      statusEl.className = 'status-msg ok';
    }

    btnLoadMap?.addEventListener('click', () => {
      if (!pendingCoords) return;
      const { lat, lon } = pendingCoords;
      const delta = 0.08;
      osmFrame.src = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - delta},${lat - delta},${lon + delta},${lat + delta}&layer=mapnik&marker=${lat},${lon}`;
      mapContainer.style.display = '';
      btnLoadMap.style.display = 'none';
    });

    btnLookup?.addEventListener('click', () => runLookup(ipInput.value));
    ipInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') runLookup(ipInput.value);
    });

    btnMyIp?.addEventListener('click', async () => {
      statusEl.textContent = L.detecting;
      statusEl.className = 'status-msg';
      try {
        const res = await fetch('https://api.ipify.org?format=json');
        const d = await res.json();
        if (d.ip) {
          ipInput.value = d.ip;
          runLookup(d.ip);
        }
      } catch {
        statusEl.textContent = L.detectErr;
        statusEl.className = 'status-msg error';
      }
    });
  })();
</script>

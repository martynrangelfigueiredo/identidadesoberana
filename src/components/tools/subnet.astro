---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "subnet")!;
const T = {
  pt: { h2: "Calcular Bloco IPv4 / CIDR", btn: "Calcular", h2Det: "Detalhes da Sub-rede" },
  de: { h2: "IPv4- / CIDR-Block berechnen", btn: "Berechnen", h2Det: "Subnetz-Details" },
  zh: { h2: "计算 IPv4 / CIDR 网段", btn: "计算", h2Det: "子网详细信息" },
  en: { h2: "Calculate IPv4 / CIDR Block", btn: "Calculate", h2Det: "Subnet Details" },
}[locale];
const L = {
  pt: {
    invalid: "Informe um endereço IPv4 válido.",
    cidr: "Notação CIDR", mask: "Máscara de Sub-rede", wildcard: "Wildcard Mask (ACL)",
    net: "Endereço de Rede", bcast: "Endereço de Broadcast", range: "Range Utilizável",
    totals: "Total de IPs / Utilizáveis", binMask: "Máscara em Binário",
    done: "Sub-rede calculada.", numLoc: "pt-BR",
  },
  de: {
    invalid: "Geben Sie eine gültige IPv4-Adresse ein.",
    cidr: "CIDR-Notation", mask: "Subnetzmaske", wildcard: "Wildcard-Maske (ACL)",
    net: "Netzwerkadresse", bcast: "Broadcast-Adresse", range: "Nutzbarer Bereich",
    totals: "Gesamte IPs / Nutzbar", binMask: "Maske (Binär)",
    done: "Subnetz berechnet.", numLoc: "de-DE",
  },
  zh: {
    invalid: "请输入有效的 IPv4 地址。",
    cidr: "CIDR 表示法", mask: "子网掩码", wildcard: "通配符掩码 (ACL)",
    net: "网络地址", bcast: "广播地址", range: "可用 IP 范围",
    totals: "总 IP 数 / 可用数", binMask: "二进制掩码",
    done: "子网计算完成。", numLoc: "zh-CN",
  },
  en: {
    invalid: "Enter a valid IPv4 address.",
    cidr: "CIDR Notation", mask: "Subnet Mask", wildcard: "Wildcard Mask (ACL)",
    net: "Network Address", bcast: "Broadcast Address", range: "Usable Range",
    totals: "Total IPs / Usable", binMask: "Binary Mask",
    done: "Subnet calculated.", numLoc: "en-US",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="CIDR"
  icon="🧮"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <div class="tool-form-row">
      <input id="sub-ip" type="text" class="tool-input" value="10.20.30.45" placeholder="10.20.30.45" aria-label="IPv4" />
      <select id="sub-cidr" class="tool-select" style="max-width:190px;" aria-label="CIDR"></select>
      <button id="btn-subnet" type="button" class="tool-btn">{T.btn}</button>
    </div>
    <p id="sub-status" class="status-msg"></p>
  </div>

  <div class="tool-card">
    <h2>{T.h2Det}</h2>
    <div id="sub-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const ipEl = document.getElementById('sub-ip');
    const cidrEl = document.getElementById('sub-cidr');
    const grid = document.getElementById('sub-grid');
    const statusEl = document.getElementById('sub-status');

    for (let p = 32; p >= 1; p--) {
      const opt = document.createElement('option');
      opt.value = String(p);
      opt.textContent = `/${p}`;
      if (p === 24) opt.selected = true;
      cidrEl.appendChild(opt);
    }

    function toStr(n) {
      return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
    }
    function toBin(n) {
      return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255]
        .map((x) => x.toString(2).padStart(8, '0'))
        .join('.');
    }
    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value}</div>`;
      grid.appendChild(box);
    }

    function calc() {
      const raw = ipEl.value.trim();
      const [ipOnly, inlinePrefix] = raw.split('/');
      if (inlinePrefix && !isNaN(Number(inlinePrefix))) {
        cidrEl.value = inlinePrefix;
        ipEl.value = ipOnly;
      }

      const parts = ipOnly.split('.').map(Number);
      if (parts.length !== 4 || parts.some((x) => isNaN(x) || x < 0 || x > 255)) {
        statusEl.textContent = L.invalid;
        statusEl.className = 'status-msg error';
        return;
      }

      const p = Number(cidrEl.value);
      const ipInt = ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
      const mask = p === 0 ? 0 : (0xffffffff << (32 - p)) >>> 0;
      const wildcard = (~mask) >>> 0;
      const net = (ipInt & mask) >>> 0;
      const bcast = (net | wildcard) >>> 0;
      const total = Math.pow(2, 32 - p);
      const usable = p >= 31 ? total : Math.max(0, total - 2);
      const firstHost = p >= 31 ? net : (net + 1) >>> 0;
      const lastHost = p >= 31 ? bcast : (bcast - 1) >>> 0;

      grid.innerHTML = '';
      addKv(L.cidr, `${toStr(net)}/${p}`);
      addKv(L.mask, toStr(mask));
      addKv(L.wildcard, toStr(wildcard));
      addKv(L.net, toStr(net));
      addKv(L.bcast, toStr(bcast));
      addKv(L.range, `${toStr(firstHost)} – ${toStr(lastHost)}`);
      addKv(L.totals, `${total.toLocaleString(L.numLoc)} / ${usable.toLocaleString(L.numLoc)}`);
      addKv(L.binMask, toBin(mask));

      statusEl.textContent = L.done;
      statusEl.className = 'status-msg ok';
    }

    document.getElementById('btn-subnet')?.addEventListener('click', calc);
    cidrEl?.addEventListener('change', calc);
    calc();
  })();
</script>


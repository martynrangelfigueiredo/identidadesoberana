---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "jwt")!;
const T = {
  pt: { badge: "100% Local", h2In: "Cole o Token JWT", btnEx: "Carregar Exemplo", btnClr: "Limpar", h2Hi: "Destaques de Segurança & IAM", h3Hdr: "Header (Cabeçalho)", h3Pay: "Payload (Claims)" },
  de: { badge: "100% Lokal", h2In: "JWT-Token einfügen", btnEx: "Beispiel laden", btnClr: "Leeren", h2Hi: "Sicherheits- & IAM-Highlights", h3Hdr: "Header", h3Pay: "Payload (Claims)" },
  zh: { badge: "100% 本地", h2In: "粘贴 JWT 令牌", btnEx: "加载示例", btnClr: "清空", h2Hi: "安全与 IAM 关键声明", h3Hdr: "Header（头部）", h3Pay: "Payload（载荷）" },
  en: { badge: "100% Local", h2In: "Paste JWT Token", btnEx: "Load Sample", btnClr: "Clear", h2Hi: "Security & IAM Highlights", h3Hdr: "Header", h3Pay: "Payload (Claims)" },
}[locale];
const L = {
  pt: {
    invalidFmt: "Formato inválido: um JWT deve conter 3 segmentos separados por ponto (Header.Payload.Signature).",
    alg: "Algoritmo (alg)", iss: "Emissor (iss)", aud: "Audiência (aud)", sub: "Sujeito / Usuário",
    tid: "Tenant ID (tid)", scp: "Escopos (scp)", roles: "Papéis (roles)", wids: "Entra Role IDs (wids)",
    amr: "Métodos Auth (amr)", ipaddr: "IP de Origem (ipaddr)", exp: "Expiração (exp)",
    validIn: "Válido (expira em {m} min)", expiredAgo: "EXPIRADO há {m} min",
    ok: "Token decodificado localmente com sucesso (nenhum dado saiu do seu navegador).",
    err: "Erro ao decodificar JWT: ",
  },
  de: {
    invalidFmt: "Ungültiges Format: Ein JWT muss aus 3 durch Punkte getrennten Segmenten bestehen (Header.Payload.Signature).",
    alg: "Algorithmus (alg)", iss: "Aussteller (iss)", aud: "Zielgruppe (aud)", sub: "Subjekt / Benutzer",
    tid: "Tenant-ID (tid)", scp: "Bereiche (scp)", roles: "Rollen (roles)", wids: "Entra Role IDs (wids)",
    amr: "Auth-Methoden (amr)", ipaddr: "Quell-IP (ipaddr)", exp: "Ablaufzeit (exp)",
    validIn: "Gültig (läuft in {m} Min. ab)", expiredAgo: "ABGELAUFEN vor {m} Min.",
    ok: "Token lokal erfolgreich dekodiert (keine Daten haben Ihren Browser verlassen).",
    err: "Fehler beim Dekodieren des JWT: ",
  },
  zh: {
    invalidFmt: "格式无效：JWT 必须包含由点分隔的 3 个部分（Header.Payload.Signature）。",
    alg: "算法 (alg)", iss: "签发者 (iss)", aud: "受众 (aud)", sub: "主体 / 用户",
    tid: "Tenant ID (tid)", scp: "权限范围 (scp)", roles: "角色 (roles)", wids: "Entra Role IDs (wids)",
    amr: "认证方式 (amr)", ipaddr: "源 IP (ipaddr)", exp: "过期时间 (exp)",
    validIn: "有效（将在 {m} 分钟后过期）", expiredAgo: "已过期 {m} 分钟",
    ok: "已在本地成功解码令牌（未向外部发送任何数据）。",
    err: "解码 JWT 时出错：",
  },
  en: {
    invalidFmt: "Invalid format: a JWT must contain 3 dot-separated segments (Header.Payload.Signature).",
    alg: "Algorithm (alg)", iss: "Issuer (iss)", aud: "Audience (aud)", sub: "Subject / User",
    tid: "Tenant ID (tid)", scp: "Scopes (scp)", roles: "Roles (roles)", wids: "Entra Role IDs (wids)",
    amr: "Auth Methods (amr)", ipaddr: "Source IP (ipaddr)", exp: "Expiration (exp)",
    validIn: "Valid (expires in {m} min)", expiredAgo: "EXPIRED {m} min ago",
    ok: "Token decoded locally with success (no data left your browser).",
    err: "Error decoding JWT: ",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge={T.badge}
  icon="🔑"
>
  <div class="tool-card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem;">
      <h2 style="margin:0;">{T.h2In}</h2>
      <div style="display:flex;gap:.5rem;">
        <button id="btn-sample" type="button" class="tool-btn secondary">{T.btnEx}</button>
        <button id="btn-clear" type="button" class="tool-btn outline">{T.btnClr}</button>
      </div>
    </div>
    <textarea
      id="jwt-input"
      class="tool-textarea"
      rows="5"
      placeholder="eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
      aria-label="Token JWT"
    ></textarea>
    <p id="jwt-status" class="status-msg"></p>
  </div>

  <div id="jwt-highlights-card" class="tool-card" style="display:none;">
    <h2>{T.h2Hi}</h2>
    <div id="jwt-highlights" class="tool-grid"></div>
  </div>

  <div id="jwt-output-card" class="tool-grid" style="display:none;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));">
    <div class="tool-card">
      <h3>{T.h3Hdr}</h3>
      <pre id="jwt-header" class="code-out"></pre>
    </div>
    <div class="tool-card">
      <h3>{T.h3Pay}</h3>
      <pre id="jwt-payload" class="code-out"></pre>
    </div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L, locale }}>
  (() => {
    const input = document.getElementById('jwt-input');
    const statusEl = document.getElementById('jwt-status');
    const highlightsCard = document.getElementById('jwt-highlights-card');
    const highlightsGrid = document.getElementById('jwt-highlights');
    const outputCard = document.getElementById('jwt-output-card');
    const headerPre = document.getElementById('jwt-header');
    const payloadPre = document.getElementById('jwt-payload');

    function base64UrlDecode(str) {
      let b64 = str.replace(/-/g, '+').replace(/_/g, '/');
      while (b64.length % 4) b64 += '=';
      const bin = atob(b64);
      const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value;
      box.appendChild(l);
      box.appendChild(v);
      highlightsGrid.appendChild(box);
    }

    function formatTime(epoch) {
      if (!epoch) return '—';
      return new Date(epoch * 1000).toISOString().replace('T', ' ').replace('.000Z', ' UTC');
    }

    function parseJwt(token) {
      const raw = token.trim();
      if (!raw) {
        statusEl.textContent = '';
        highlightsCard.style.display = 'none';
        outputCard.style.display = 'none';
        return;
      }

      const parts = raw.split('.');
      if (parts.length !== 3) {
        statusEl.textContent = L.invalidFmt;
        statusEl.className = 'status-msg error';
        highlightsCard.style.display = 'none';
        outputCard.style.display = 'none';
        return;
      }

      try {
        const header = JSON.parse(base64UrlDecode(parts[0]));
        const payload = JSON.parse(base64UrlDecode(parts[1]));

        headerPre.textContent = JSON.stringify(header, null, 2);
        payloadPre.textContent = JSON.stringify(payload, null, 2);

        highlightsGrid.innerHTML = '';
        addKv(L.alg, header.alg || '—');
        addKv(L.iss, payload.iss || '—');
        addKv(L.aud, Array.isArray(payload.aud) ? payload.aud.join(', ') : (payload.aud || '—'));
        addKv(L.sub, payload.upn || payload.preferred_username || payload.unique_name || payload.sub || '—');

        if (payload.tid) addKv(L.tid, payload.tid);
        if (payload.scp) addKv(L.scp, payload.scp);
        if (payload.roles) addKv(L.roles, Array.isArray(payload.roles) ? payload.roles.join(', ') : String(payload.roles));
        if (payload.wids) addKv(L.wids, Array.isArray(payload.wids) ? payload.wids.join(', ') : String(payload.wids));
        if (payload.amr) addKv(L.amr, Array.isArray(payload.amr) ? payload.amr.join(', ') : String(payload.amr));
        if (payload.ipaddr) addKv(L.ipaddr, payload.ipaddr);

        if (payload.exp) {
          const now = Math.floor(Date.now() / 1000);
          const diff = payload.exp - now;
          const mins = Math.abs(Math.floor(diff / 60));
          const expStatus = (diff > 0 ? L.validIn : L.expiredAgo).replace('{m}', String(mins));
          addKv(L.exp, `${formatTime(payload.exp)} · ${expStatus}`);
        }

        // Contexto situacional de IAM
        const issStr = String(payload.iss || '').toLowerCase();
        let idp = 'Custom / Generic OIDC';
        if (issStr.includes('login.microsoftonline.com') || issStr.includes('sts.windows.net')) idp = 'Microsoft Entra ID';
        else if (issStr.includes('keycloak') || issStr.includes('/realms/')) idp = 'Keycloak';
        else if (issStr.includes('auth0.com')) idp = 'Auth0';
        else if (issStr.includes('okta.com')) idp = 'Okta';
        else if (issStr.includes('accounts.google.com')) idp = 'Google Identity';

        const isAppOnly = payload.idtyp === 'app' || (!payload.scp && payload.roles && !payload.upn && !payload.preferred_username);
        const amrList = Array.isArray(payload.amr) ? payload.amr.map((x) => String(x).toLowerCase()) : [];
        const hasMfa = amrList.includes('mfa') || amrList.includes('ngcmfa') || amrList.includes('fido');
        const hasWids = Boolean(payload.wids && (!Array.isArray(payload.wids) || payload.wids.length > 0));

        const iamLabel = { pt: 'Contexto Situacional (IAM / SOC)', de: 'Situativer Kontext (IAM / SOC)', zh: 'IAM / SOC 情景研判', en: 'Situational Context (IAM / SOC)' }[locale] || 'Context';
        const iamParts = [`IdP: ${idp}`];
        iamParts.push(isAppOnly ? ({ pt: 'Tipo: App-Only (Service Principal)', de: 'Typ: App-Only (Service Principal)', zh: '类型：仅应用 (Service Principal)', en: 'Type: App-Only (Service Principal)' }[locale]) : ({ pt: 'Tipo: Usuário Delegado', de: 'Typ: Delegierter Benutzer', zh: '类型：委托用户令牌', en: 'Type: Delegated User' }[locale]));
        if (amrList.length) iamParts.push(hasMfa ? 'MFA: ✔' : 'MFA: ⚠️ Single-factor');
        if (hasWids) iamParts.push({ pt: '⚠️ Possui wids (Papel privilegiado Entra ID)', de: '⚠️ Enthält wids (Privilegierte Entra-Rolle)', zh: '⚠️ 包含 wids（Entra ID 特权角色）', en: '⚠️ Contains wids (Privileged Entra Role)' }[locale]);

        const ctxBox = document.createElement('div');
        ctxBox.className = 'kv-box wide';
        ctxBox.innerHTML = `<div class="kv-label">${iamLabel}</div><div class="kv-value">${iamParts.join(' · ')}</div>`;
        highlightsGrid.appendChild(ctxBox);

        highlightsCard.style.display = '';
        outputCard.style.display = '';
        statusEl.textContent = L.ok;
        statusEl.className = 'status-msg ok';
      } catch (err) {
        statusEl.textContent = `${L.err}${err.message}`;
        statusEl.className = 'status-msg error';
        highlightsCard.style.display = 'none';
        outputCard.style.display = 'none';
      }
    }

    input?.addEventListener('input', () => parseJwt(input.value));

    document.getElementById('btn-clear')?.addEventListener('click', () => {
      input.value = '';
      parseJwt('');
    });

    document.getElementById('btn-sample')?.addEventListener('click', () => {
      const b64u = (obj) => btoa(JSON.stringify(obj)).replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_');
      const now = Math.floor(Date.now() / 1000);
      const sampleHeader = { alg: 'RS256', typ: 'JWT', kid: 'sample-key-id-01' };
      const samplePayload = {
        aud: 'https://graph.microsoft.com',
        iss: 'https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0',
        iat: now - 300,
        exp: now + 3300,
        tid: '00000000-0000-0000-0000-000000000000',
        upn: 'analista.soc@contoso.com',
        amr: ['pwd', 'mfa'],
        scp: 'User.Read SecurityIncident.Read.All',
        ipaddr: '198.51.100.45',
      };
      input.value = `${b64u(sampleHeader)}.${b64u(samplePayload)}.exemplo-assinatura-nao-validada`;
      parseJwt(input.value);
    });
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "defang")!;
const T = {
  pt: {
    h2Def: "1. IoC Defang & Refang",
    btnDef: "Defang (Sanitizar)", btnRef: "Refang (Restaurar)",
    h2B64: "2. Base64 & PowerShell (-EncodedCommand) Decoder",
    btnU8: "Decodificar UTF-8", btnPs: "Decodificar PowerShell (UTF-16LE)", btnEnc: "Codificar Base64",
    h2Hash: "3. Gerador de Hash Local (Web Crypto API · Zero Upload)",
    btnHash: "Calcular Hash do Texto",
    copied: "✔ Copiado!",
    copyOut: "Copiar Saída",
    errU8: "Erro ao decodificar UTF-8:",
    errPs: "Erro ao decodificar PowerShell UTF-16LE:",
  },
  de: {
    h2Def: "1. IoC Defang & Refang",
    btnDef: "Defang (Entschärfen)", btnRef: "Refang (Wiederherstellen)",
    h2B64: "2. Base64 & PowerShell (-EncodedCommand) Decoder",
    btnU8: "UTF-8 dekodieren", btnPs: "PowerShell (UTF-16LE) dekodieren", btnEnc: "Base64 kodieren",
    h2Hash: "3. Lokaler Hash-Generator (Web Crypto API · Kein Upload)",
    btnHash: "Text-Hash berechnen",
    copied: "✔ Kopiert!",
    copyOut: "Ausgabe kopieren",
    errU8: "Fehler beim UTF-8-Dekodieren:",
    errPs: "Fehler beim PowerShell-UTF-16LE-Dekodieren:",
  },
  zh: {
    h2Def: "1. IoC 安全脱敏（Defang & Refang）",
    btnDef: "Defang（脱敏）", btnRef: "Refang（还原）",
    h2B64: "2. Base64 与 PowerShell (-EncodedCommand) 解码",
    btnU8: "解码 UTF-8", btnPs: "解码 PowerShell (UTF-16LE)", btnEnc: "编码为 Base64",
    h2Hash: "3. 本地哈希计算（Web Crypto API · 零上传）",
    btnHash: "计算文本哈希",
    copied: "✔ 已复制！",
    copyOut: "复制输出",
    errU8: "UTF-8 解码错误：",
    errPs: "PowerShell UTF-16LE 解码错误：",
  },
  en: {
    h2Def: "1. IoC Defang & Refang",
    btnDef: "Defang (Sanitize)", btnRef: "Refang (Restore)",
    h2B64: "2. Base64 & PowerShell (-EncodedCommand) Decoder",
    btnU8: "Decode UTF-8", btnPs: "Decode PowerShell (UTF-16LE)", btnEnc: "Encode Base64",
    h2Hash: "3. Local Hash Generator (Web Crypto API · Zero Upload)",
    btnHash: "Compute Text Hash",
    copied: "✔ Copied!",
    copyOut: "Copy Output",
    errU8: "UTF-8 decode error:",
    errPs: "PowerShell UTF-16LE decode error:",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="100% Local"
  icon="🛡️"
>
  <!-- 1. Defang / Refang -->
  <div class="tool-card">
    <h2>{T.h2Def}</h2>
    <textarea
      id="defang-input"
      class="tool-textarea"
      rows="3"
      placeholder="Ex: https://login-malicioso.example.com/auth?ip=198.51.100.45"
      aria-label={T.h2Def}
    ></textarea>
    <div style="display:flex;gap:.5rem;margin-top:.75rem;flex-wrap:wrap;">
      <button id="btn-defang" type="button" class="tool-btn">{T.btnDef}</button>
      <button id="btn-refang" type="button" class="tool-btn secondary">{T.btnRef}</button>
    </div>
    <pre id="defang-out" class="code-out" style="margin-top:.85rem;display:none;"></pre>
  </div>

  <!-- 2. Base64 & PowerShell UTF-16LE -->
  <div class="tool-card">
    <h2>{T.h2B64}</h2>
    <textarea
      id="b64-input"
      class="tool-textarea"
      rows="3"
      placeholder="Base64 (UTF-8 / PowerShell UTF-16LE)..."
      aria-label={T.h2B64}
    ></textarea>
    <div style="display:flex;gap:.5rem;margin-top:.75rem;flex-wrap:wrap;">
      <button id="btn-b64-utf8" type="button" class="tool-btn">{T.btnU8}</button>
      <button id="btn-b64-ps" type="button" class="tool-btn secondary">{T.btnPs}</button>
      <button id="btn-b64-enc" type="button" class="tool-btn outline">{T.btnEnc}</button>
    </div>
    <pre id="b64-out" class="code-out" style="margin-top:.85rem;display:none;"></pre>
  </div>

  <!-- 3. Hash Local (SHA-256 / SHA-512) -->
  <div class="tool-card">
    <h2>{T.h2Hash}</h2>
    <textarea
      id="hash-input"
      class="tool-textarea"
      rows="2"
      placeholder="..."
      aria-label={T.h2Hash}
    ></textarea>
    <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-top:.75rem;">
      <input id="hash-file" type="file" aria-label="File" />
      <button id="btn-hash-text" type="button" class="tool-btn">{T.btnHash}</button>
    </div>
    <div id="hash-grid" class="tool-grid" style="margin-top:.85rem;"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ T }}>
  (() => {
    // 1. Defang / Refang
    const defangIn = document.getElementById('defang-input');
    const defangOut = document.getElementById('defang-out');

    document.getElementById('btn-defang')?.addEventListener('click', () => {
      let s = defangIn.value;
      s = s.replace(/https:\/\//gi, 'hxxps[://]').replace(/http:\/\//gi, 'hxxp[://]').replace(/\./g, '[.]');
      defangOut.style.display = '';
      defangOut.textContent = s;
    });

    document.getElementById('btn-refang')?.addEventListener('click', () => {
      let s = defangIn.value;
      s = s.replace(/hxxps\[:\/\/\]/gi, 'https://').replace(/hxxp\[:\/\/\]/gi, 'http://').replace(/\[\.\]/g, '.');
      defangOut.style.display = '';
      defangOut.textContent = s;
    });

    document.getElementById('btn-copy-defang')?.addEventListener('click', async (e) => {
      if (!defangOut.textContent) return;
      await navigator.clipboard.writeText(defangOut.textContent);
      e.target.textContent = T.copied;
      setTimeout(() => (e.target.textContent = T.copyOut), 1600);
    });

    // 2. Base64 & PowerShell
    const b64In = document.getElementById('b64-input');
    const b64Out = document.getElementById('b64-out');

    function decodeBase64Bytes(str) {
      const clean = str.trim().replace(/\s+/g, '');
      const bin = atob(clean);
      return Uint8Array.from(bin, (c) => c.charCodeAt(0));
    }

    document.getElementById('btn-b64-utf8')?.addEventListener('click', () => {
      try {
        const bytes = decodeBase64Bytes(b64In.value);
        b64Out.style.display = '';
        b64Out.textContent = new TextDecoder('utf-8').decode(bytes);
      } catch (err) {
        b64Out.style.display = '';
        b64Out.textContent = `${T.errU8} ${err.message}`;
      }
    });

    document.getElementById('btn-b64-ps')?.addEventListener('click', () => {
      try {
        const bytes = decodeBase64Bytes(b64In.value);
        b64Out.style.display = '';
        b64Out.textContent = new TextDecoder('utf-16le').decode(bytes);
      } catch (err) {
        b64Out.style.display = '';
        b64Out.textContent = `${T.errPs} ${err.message}`;
      }
    });

    document.getElementById('btn-b64-enc')?.addEventListener('click', () => {
      const bytes = new TextEncoder().encode(b64In.value);
      let bin = '';
      bytes.forEach((b) => (bin += String.fromCharCode(b)));
      b64Out.style.display = '';
      b64Out.textContent = btoa(bin);
    });

    // 3. Hash Local
    const hashIn = document.getElementById('hash-input');
    const hashFile = document.getElementById('hash-file');
    const hashGrid = document.getElementById('hash-grid');

    function toHex(buf) {
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function computeHashes(buffer, sourceName) {
      hashGrid.innerHTML = '';
      const algos = ['SHA-1', 'SHA-256', 'SHA-512'];
      for (const alg of algos) {
        const digest = await crypto.subtle.digest(alg, buffer);
        const box = document.createElement('div');
        box.className = 'kv-box';
        const l = document.createElement('div');
        l.className = 'kv-label';
        l.textContent = `${alg} (${sourceName})`;
        const v = document.createElement('div');
        v.className = 'kv-value';
        v.textContent = toHex(digest);
        box.appendChild(l);
        box.appendChild(v);
        hashGrid.appendChild(box);
      }
    }

    document.getElementById('btn-hash-text')?.addEventListener('click', () => {
      const buf = new TextEncoder().encode(hashIn.value).buffer;
      computeHashes(buf, 'Texto');
    });

    hashFile?.addEventListener('change', async () => {
      const file = hashFile.files?.[0];
      if (!file) return;
      const buf = await file.arrayBuffer();
      computeHashes(buf, file.name);
    });
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "rdap")!;
const T = {
  pt: { h2: "Consultar IP ou Domínio via RDAP", ph: "Ex: 8.8.8.8 ou microsoft.com", btn: "Consultar RDAP", h2Sum: "Resumo de Registro", h2Raw: "Resposta JSON Bruta (RDAP)" },
  de: { h2: "IP oder Domain via RDAP abfragen", ph: "z. B. 8.8.8.8 oder microsoft.com", btn: "RDAP abfragen", h2Sum: "Registrierungs-Zusammenfassung", h2Raw: "Rohe JSON-Antwort (RDAP)" },
  zh: { h2: "通过 RDAP 查询 IP 或域名", ph: "例如：8.8.8.8 或 microsoft.com", btn: "查询 RDAP", h2Sum: "注册摘要信息", h2Raw: "原始 JSON 响应 (RDAP)" },
  en: { h2: "Lookup IP or Domain via RDAP", ph: "e.g., 8.8.8.8 or microsoft.com", btn: "Lookup RDAP", h2Sum: "Registry Summary", h2Raw: "Raw JSON Response (RDAP)" },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="IETF RDAP"
  icon="📋"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <div class="tool-form-row">
      <input id="rdap-input" type="text" class="tool-input" placeholder={T.ph} aria-label={T.h2} />
      <button id="btn-rdap" type="button" class="tool-btn">{T.btn}</button>
    </div>
    <p id="rdap-status" class="status-msg"></p>
  </div>

  <div id="rdap-summary-card" class="tool-card" style="display:none;">
    <h2>{T.h2Sum}</h2>
    <div id="rdap-grid" class="tool-grid"></div>
  </div>

  <div id="rdap-raw-card" class="tool-card" style="display:none;">
    <h2>{T.h2Raw}</h2>
    <pre id="rdap-raw" class="code-out"></pre>
  </div>
</ToolShell>

<script is:inline>
  (() => {
    const input = document.getElementById('rdap-input');
    const btn = document.getElementById('btn-rdap');
    const statusEl = document.getElementById('rdap-status');
    const summaryCard = document.getElementById('rdap-summary-card');
    const grid = document.getElementById('rdap-grid');
    const rawCard = document.getElementById('rdap-raw-card');
    const rawPre = document.getElementById('rdap-raw');

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value || '—';
      box.appendChild(l);
      box.appendChild(v);
      grid.appendChild(box);
    }

    function isIp(str) {
      return /^(\d{1,3}\.){3}\d{1,3}$/.test(str) || str.includes(':');
    }

    function extractEmails(entities) {
      const emails = [];
      (entities || []).forEach((ent) => {
        const vcard = ent.vcardArray?.[1] || [];
        vcard.forEach((field) => {
          if (field[0] === 'email' && field[3]) emails.push(field[3]);
        });
        if (ent.entities) emails.push(...extractEmails(ent.entities));
      });
      return [...new Set(emails)];
    }

    async function runRdap() {
      const target = input.value.trim().replace(/^https?:\/\//, '').split('/')[0];
      if (!target) {
        statusEl.textContent = 'Informe um IP ou domínio válido.';
        statusEl.className = 'status-msg error';
        return;
      }

      statusEl.textContent = `Consultando rdap.org para ${target}...`;
      statusEl.className = 'status-msg';
      grid.innerHTML = '';

      const type = isIp(target) ? 'ip' : 'domain';
      try {
        const res = await fetch(`https://rdap.org/${type}/${encodeURIComponent(target)}`);
        if (!res.ok) throw new Error(`HTTP ${res.status} — Registro não encontrado ou servidor RDAP indisponível`);
        const data = await res.json();

        summaryCard.style.display = '';
        rawCard.style.display = '';

        addKv('Identificador / Handle', data.handle || data.ldhName || target);
        addKv('Nome / Bloco', data.name || data.ldhName || '—');
        addKv('Status', Array.isArray(data.status) ? data.status.join(', ') : '—');

        const events = data.events || [];
        const regEvent = events.find((e) => e.eventAction === 'registration');
        const expEvent = events.find((e) => e.eventAction === 'expiration');
        const updEvent = events.find((e) => e.eventAction === 'last changed');

        if (regEvent) addKv('Criação / Registro', regEvent.eventDate);
        if (expEvent) addKv('Expiração', expEvent.eventDate);
        if (updEvent) addKv('Última Atualização', updEvent.eventDate);

        if (data.nameservers?.length) {
          addKv('Nameservers', data.nameservers.map((n) => n.ldhName).join(', '));
        }

        const emails = extractEmails(data.entities);
        addKv('Contatos / Abuse', emails.length ? emails.join(', ') : 'Não exposto via RDAP');

        rawPre.textContent = JSON.stringify(data, null, 2);
        statusEl.textContent = 'Consulta RDAP concluída.';
        statusEl.className = 'status-msg ok';
      } catch (err) {
        statusEl.textContent = `Erro: ${err.message}`;
        statusEl.className = 'status-msg error';
        summaryCard.style.display = 'none';
        rawCard.style.display = 'none';
      }
    }

    btn?.addEventListener('click', runRdap);
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') runRdap();
    });
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "epoch")!;
const T = {
  pt: { h2: "Inserir Timestamp ou Data ISO", btnNow: "Agora (Tempo Real)", btnConv: "Converter", h2Res: "Formatos Convertidos" },
  de: { h2: "Zeitstempel oder ISO-Datum eingeben", btnNow: "Jetzt (Echtzeit)", btnConv: "Konvertieren", h2Res: "Konvertierte Formate" },
  zh: { h2: "输入时间戳或 ISO 日期", btnNow: "当前时间", btnConv: "转换", h2Res: "转换结果" },
  en: { h2: "Enter Timestamp or ISO Date", btnNow: "Now (Real-Time)", btnConv: "Convert", h2Res: "Converted Formats" },
}[locale];
const L = {
  pt: {
    ft: "Windows FILETIME / AD Timestamp (100ns)",
    us: "Unix Epoch (Microssegundos)", ms: "Unix Epoch (Milissegundos)", sec: "Unix Epoch (Segundos)",
    isoStr: "String de Data / ISO 8601",
    invalid: "Formato não reconhecido. Use Epoch numérico, FILETIME (18 dígitos) ou data ISO.",
    fmtDet: "Formato Detectado", utc: "UTC (ISO 8601)", localTime: "Horário Local (Navegador)",
    kSec: "Unix Epoch (Segundos)", kMs: "Unix Epoch (Milissegundos)", kFt: "Windows FILETIME (AD/Entra)",
    done: "Conversão realizada.", dateLoc: "pt-BR",
  },
  de: {
    ft: "Windows FILETIME / AD-Zeitstempel (100ns)",
    us: "Unix-Epoch (Mikrosekunden)", ms: "Unix-Epoch (Millisekunden)", sec: "Unix-Epoch (Sekunden)",
    isoStr: "Datumsstring / ISO 8601",
    invalid: "Format nicht erkannt. Verwenden Sie Unix-Epoch, FILETIME (18 Ziffern) oder ISO-Datum.",
    fmtDet: "Erkanntes Format", utc: "UTC (ISO 8601)", localTime: "Lokale Zeit (Browser)",
    kSec: "Unix-Epoch (Sekunden)", kMs: "Unix-Epoch (Millisekunden)", kFt: "Windows FILETIME (AD/Entra)",
    done: "Konvertierung abgeschlossen.", dateLoc: "de-DE",
  },
  zh: {
    ft: "Windows FILETIME / AD 时间戳 (100ns)",
    us: "Unix 时间戳（微秒）", ms: "Unix 时间戳（毫秒）", sec: "Unix 时间戳（秒）",
    isoStr: "日期字符串 / ISO 8601",
    invalid: "无法识别的格式。请使用数字时间戳、FILETIME（18 位）或 ISO 日期。",
    fmtDet: "检测到的格式", utc: "UTC (ISO 8601)", localTime: "本地时间（浏览器）",
    kSec: "Unix 时间戳（秒）", kMs: "Unix 时间戳（毫秒）", kFt: "Windows FILETIME (AD/Entra)",
    done: "转换完成。", dateLoc: "zh-CN",
  },
  en: {
    ft: "Windows FILETIME / AD Timestamp (100ns)",
    us: "Unix Epoch (Microseconds)", ms: "Unix Epoch (Milliseconds)", sec: "Unix Epoch (Seconds)",
    isoStr: "Date String / ISO 8601",
    invalid: "Unrecognized format. Use numeric Epoch, FILETIME (18 digits), or ISO date.",
    fmtDet: "Detected Format", utc: "UTC (ISO 8601)", localTime: "Local Time (Browser)",
    kSec: "Unix Epoch (Seconds)", kMs: "Unix Epoch (Milliseconds)", kFt: "Windows FILETIME (AD/Entra)",
    done: "Conversion completed.", dateLoc: "en-US",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="DFIR & KQL"
  icon="⏱️"
>
  <div class="tool-card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem;">
      <h2 style="margin:0;">{T.h2}</h2>
      <button id="btn-now" type="button" class="tool-btn secondary">{T.btnNow}</button>
    </div>
    <div class="tool-form-row">
      <input
        id="ts-input"
        type="text"
        class="tool-input"
        placeholder="Ex: 1795000000, 134131200000000000, 2026-11-18T12:00:00Z"
        aria-label={T.h2}
      />
      <button id="btn-convert" type="button" class="tool-btn">{T.btnConv}</button>
    </div>
    <p id="ts-status" class="status-msg"></p>
  </div>

  <div id="ts-result-card" class="tool-card" style="display:none;">
    <h2>{T.h2Res}</h2>
    <div id="ts-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const input = document.getElementById('ts-input');
    const btnConvert = document.getElementById('btn-convert');
    const btnNow = document.getElementById('btn-now');
    const statusEl = document.getElementById('ts-status');
    const resultCard = document.getElementById('ts-result-card');
    const grid = document.getElementById('ts-grid');

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value;
      box.appendChild(l);
      box.appendChild(v);
      grid.appendChild(box);
    }

    function convert(raw) {
      const val = (raw || '').trim();
      if (!val) return;
      let dateObj = null;
      let detectedType = '';

      if (/^\d+$/.test(val)) {
        const num = Number(val);
        if (val.length >= 17) {
          // Windows FILETIME (100ns ticks since 1601-01-01)
          const msSince1970 = (num / 10000) - 11644473600000;
          dateObj = new Date(msSince1970);
          detectedType = L.ft;
        } else if (val.length >= 15) {
          dateObj = new Date(num / 1000);
          detectedType = L.us;
        } else if (val.length >= 12) {
          dateObj = new Date(num);
          detectedType = L.ms;
        } else {
          dateObj = new Date(num * 1000);
          detectedType = L.sec;
        }
      } else {
        dateObj = new Date(val);
        detectedType = L.isoStr;
      }

      if (!dateObj || isNaN(dateObj.getTime())) {
        statusEl.textContent = L.invalid;
        statusEl.className = 'status-msg error';
        resultCard.style.display = 'none';
        return;
      }

      const ms = dateObj.getTime();
      const sec = Math.floor(ms / 1000);
      const filetime = Math.round((ms + 11644473600000) * 10000);
      const iso = dateObj.toISOString();

      grid.innerHTML = '';
      addKv(L.fmtDet, detectedType);
      addKv(L.utc, iso);
      addKv(L.localTime, dateObj.toLocaleString(L.dateLoc, { dateStyle: 'short', timeStyle: 'medium' }));
      addKv(L.kSec, String(sec));
      addKv(L.kMs, String(ms));
      addKv(L.kFt, String(filetime));
      addKv('KQL datetime()', `datetime(${iso})`);

      resultCard.style.display = '';
      statusEl.textContent = L.done;
      statusEl.className = 'status-msg ok';
    }

    btnConvert?.addEventListener('click', () => convert(input.value));
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') convert(input.value);
    });
    btnNow?.addEventListener('click', () => {
      const nowSec = Math.floor(Date.now() / 1000);
      input.value = String(nowSec);
      convert(input.value);
    });

    // Inicializar com agora
    const initSec = Math.floor(Date.now() / 1000);
    input.value = String(initSec);
    convert(input.value);
  })();
</script>


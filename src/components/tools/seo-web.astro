---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "seo-web")!;
const T = {
  pt: { h2Seo: "1. Gerador de Meta Tags Open Graph & Schema JSON-LD", btnSeo: "Gerar Meta Tags & JSON-LD", h2Rob: "2. Gerador de Robots.txt", btnRob: "Gerar robots.txt" },
  de: { h2Seo: "1. Open-Graph-Meta-Tags & Schema JSON-LD Generator", btnSeo: "Meta-Tags & JSON-LD generieren", h2Rob: "2. Robots.txt Generator", btnRob: "robots.txt generieren" },
  zh: { h2Seo: "1. Open Graph 元标签与 Schema JSON-LD 生成器", btnSeo: "生成 Meta 标签与 JSON-LD", h2Rob: "2. Robots.txt 生成器", btnRob: "生成 robots.txt" },
  en: { h2Seo: "1. Open Graph Meta Tags & Schema JSON-LD Generator", btnSeo: "Generate Meta Tags & JSON-LD", h2Rob: "2. Robots.txt Generator", btnRob: "Generate robots.txt" },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Web & SEO"
  icon="🔎"
>
  <div class="tool-card">
    <h2>{T.h2Seo}</h2>
    <div class="tool-grid" style="margin-bottom:1rem;">
      <input id="seo-title" type="text" class="tool-input" value="Identidade Soberana — SecOps e IAM" aria-label="Title" />
      <input id="seo-url" type="url" class="tool-input" value="https://identidadesoberana.com.br/" aria-label="URL" />
      <input id="seo-desc" type="text" class="tool-input" value="Guias práticos de SOC, Microsoft Sentinel, Entra ID e segurança aberta." aria-label="Description" />
    </div>
    <button id="btn-seo" type="button" class="tool-btn">{T.btnSeo}</button>
    <pre id="seo-out" class="code-out" style="margin-top:.85rem;"></pre>
  </div>

  <div class="tool-card">
    <h2>{T.h2Rob}</h2>
    <div class="tool-form-row" style="margin-bottom:.85rem;">
      <input id="rob-sitemap" type="url" class="tool-input" value="https://identidadesoberana.com.br/sitemap.xml" aria-label="Sitemap URL" />
      <select id="rob-policy" class="tool-select" style="max-width:220px;" aria-label="Policy">
        <option value="allow" selected>Allow: /</option>
        <option value="disallow">Disallow: /</option>
      </select>
      <button id="btn-rob" type="button" class="tool-btn">{T.btnRob}</button>
    </div>
    <pre id="rob-out" class="code-out"></pre>
  </div>
</ToolShell>

<script is:inline>
  (() => {
    const titleEl = document.getElementById('seo-title');
    const urlEl = document.getElementById('seo-url');
    const descEl = document.getElementById('seo-desc');
    const seoOut = document.getElementById('seo-out');

    function genSeo() {
      const t = titleEl.value.trim();
      const u = urlEl.value.trim();
      const d = descEl.value.trim();
      const ld = JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: t,
        url: u,
        description: d,
      }, null, 2);

      seoOut.textContent =
        `<meta property="og:type" content="website" />\n` +
        `<meta property="og:title" content="${t}" />\n` +
        `<meta property="og:description" content="${d}" />\n` +
        `<meta property="og:url" content="${u}" />\n\n` +
        `<script type="application/ld+json">\n${ld}\n<\/script>`;
    }

    const robSitemap = document.getElementById('rob-sitemap');
    const robPolicy = document.getElementById('rob-policy');
    const robOut = document.getElementById('rob-out');
    function genRobots() {
      const rule = robPolicy.value === 'allow' ? 'Allow: /' : 'Disallow: /';
      robOut.textContent = `User-agent: *\n${rule}\n\nSitemap: ${robSitemap.value.trim()}`;
    }

    document.getElementById('btn-seo')?.addEventListener('click', genSeo);
    document.getElementById('btn-rob')?.addEventListener('click', genRobots);
    genSeo();
    genRobots();
  })();
</script>


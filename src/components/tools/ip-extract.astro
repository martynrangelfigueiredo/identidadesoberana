---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "ip-extract")!;
const T = {
  pt: { h2: "1. Extrair IPs de Logs / Texto Bruto & Bulk Lookup", btnExt: "Extrair IPs Únicos", btnBulk: "Consultar Geo/ASN em Lote (até 10)", btnGen: "Gerar 5 IPs Aleatórios", h2Res: "Resultado da Consulta em Lote", thLoc: "País / Cidade", thOrg: "ASN / Organização" },
  de: { h2: "1. IPs aus Logs extrahieren & Bulk Lookup", btnExt: "Eindeutige IPs extrahieren", btnBulk: "Bulk-Geo/ASN-Lookup (bis 10)", btnGen: "5 Zufalls-IPs generieren", h2Res: "Bulk-Lookup-Ergebnis", thLoc: "Land / Stadt", thOrg: "ASN / Organisation" },
  zh: { h2: "1. 从原始日志提取 IP 与批量查询", btnExt: "提取去重 IP", btnBulk: "批量 Geo/ASN 查询（最多 10 个）", btnGen: "生成 5 个随机测试 IP", h2Res: "批量查询结果", thLoc: "国家 / 城市", thOrg: "ASN / 组织" },
  en: { h2: "1. Extract IPs from Logs & Bulk Lookup", btnExt: "Extract Unique IPs", btnBulk: "Bulk Geo/ASN Lookup (up to 10)", btnGen: "Generate 5 Random IPs", h2Res: "Bulk Lookup Results", thLoc: "Country / City", thOrg: "ASN / Organization" },
}[locale];
const L = {
  pt: {
    noValid: "Nenhum endereço IPv4 válido encontrado.",
    extracted: "{n} endereço(s) único(s) extraído(s).",
    noIp: "Nenhum IP encontrado para consultar.",
    querying: "Consultando {n} IPs...",
    privRes: "Privado/Reservado",
    err: "Erro na consulta",
    done: "Consulta em lote concluída ({n} IPs).",
  },
  de: {
    noValid: "Keine gültige IPv4-Adresse gefunden.",
    extracted: "{n} eindeutige Adresse(n) extrahiert.",
    noIp: "Keine IP für die Abfrage gefunden.",
    querying: "{n} IPs werden abgefragt...",
    privRes: "Privat/Reserviert",
    err: "Abfragefehler",
    done: "Bulk-Abfrage abgeschlossen ({n} IPs).",
  },
  zh: {
    noValid: "未找到有效的 IPv4 地址。",
    extracted: "已提取 {n} 个唯一地址。",
    noIp: "未找到可查询的 IP。",
    querying: "正在查询 {n} 个 IP...",
    privRes: "私有/保留地址",
    err: "查询出错",
    done: "批量查询完成（{n} 个 IP）。",
  },
  en: {
    noValid: "No valid IPv4 address found.",
    extracted: "{n} unique address(es) extracted.",
    noIp: "No IP found to query.",
    querying: "Querying {n} IPs...",
    privRes: "Private/Reserved",
    err: "Lookup error",
    done: "Bulk lookup completed ({n} IPs).",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Bulk & Logs"
  icon="📦"
>
  <div class="tool-card">
    <h2>{T.h2}</h2>
    <textarea
      id="bulk-input"
      class="tool-textarea"
      rows="5"
      placeholder="..."
      aria-label={T.h2}
    ></textarea>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem;">
      <button id="btn-extract" type="button" class="tool-btn">{T.btnExt}</button>
      <button id="btn-bulk-geo" type="button" class="tool-btn secondary">{T.btnBulk}</button>
      <button id="btn-gen-ip" type="button" class="tool-btn outline">{T.btnGen}</button>
    </div>
    <p id="bulk-status" class="status-msg"></p>
  </div>

  <div id="extracted-card" class="tool-card" style="display:none;">
    <h2>IPs (<span id="ip-count">0</span>)</h2>
    <pre id="extracted-out" class="code-out"></pre>
  </div>

  <div id="bulk-results-card" class="tool-card" style="display:none;overflow-x:auto;">
    <h2>{T.h2Res}</h2>
    <table style="width:100%;border-collapse:collapse;font-size:.9rem;">
      <thead>
        <tr style="border-bottom:2px solid var(--is-borda);text-align:left;">
          <th style="padding:.55rem;">IP</th>
          <th style="padding:.55rem;">{T.thLoc}</th>
          <th style="padding:.55rem;">{T.thOrg}</th>
        </tr>
      </thead>
      <tbody id="bulk-tbody"></tbody>
    </table>
  </div>
</ToolShell>

<script is:inline define:vars={{ L }}>
  (() => {
    const input = document.getElementById('bulk-input');
    const statusEl = document.getElementById('bulk-status');
    const extractedCard = document.getElementById('extracted-card');
    const extractedOut = document.getElementById('extracted-out');
    const ipCount = document.getElementById('ip-count');
    const bulkCard = document.getElementById('bulk-results-card');
    const bulkTbody = document.getElementById('bulk-tbody');

    function extractIps(text) {
      const ipv4Regex = /\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\b/g;
      const matches = text.match(ipv4Regex) || [];
      return [...new Set(matches)];
    }

    document.getElementById('btn-extract')?.addEventListener('click', () => {
      const ips = extractIps(input.value);
      ipCount.textContent = String(ips.length);
      extractedCard.style.display = '';
      extractedOut.textContent = ips.length ? ips.join('\n') : L.noValid;
      statusEl.textContent = L.extracted.replace('{n}', String(ips.length));
      statusEl.className = 'status-msg ok';
    });

    document.getElementById('btn-gen-ip')?.addEventListener('click', () => {
      const list = [];
      for (let i = 0; i < 5; i++) {
        const b = new Uint8Array(4);
        crypto.getRandomValues(b);
        const first = (b[0] % 200) + 11;
        list.push(`${first}.${b[1]}.${b[2]}.${(b[3] % 253) + 1}`);
      }
      input.value = list.join('\n');
      document.getElementById('btn-extract')?.click();
    });

    document.getElementById('btn-bulk-geo')?.addEventListener('click', async () => {
      const ips = extractIps(input.value).slice(0, 10);
      if (!ips.length) {
        statusEl.textContent = L.noIp;
        statusEl.className = 'status-msg error';
        return;
      }
      statusEl.textContent = L.querying.replace('{n}', String(ips.length));
      statusEl.className = 'status-msg';
      bulkTbody.innerHTML = '';
      bulkCard.style.display = '';

      for (const ip of ips) {
        try {
          const res = await fetch(`https://ipwho.is/${encodeURIComponent(ip)}`);
          const d = await res.json();
          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid var(--is-borda)';
          tr.innerHTML = `
            <td style="padding:.55rem;font-family:var(--is-fonte-mono);font-weight:700;">${ip}</td>
            <td style="padding:.55rem;">${d.success ? `${d.country || '—'} · ${d.city || '—'}` : (d.message || L.privRes)}</td>
            <td style="padding:.55rem;">${d.success ? `AS${d.connection?.asn || '?'} · ${d.connection?.isp || d.connection?.org || '—'}` : '—'}</td>
          `;
          bulkTbody.appendChild(tr);
        } catch {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td style="padding:.55rem;font-family:var(--is-fonte-mono);">${ip}</td><td colspan="2" style="padding:.55rem;">${L.err}</td>`;
          bulkTbody.appendChild(tr);
        }
      }
      statusEl.textContent = L.done.replace('{n}', String(ips.length));
      statusEl.className = 'status-msg ok';
    });
  })();
</script>


---
import ToolShell from "../ToolShell.astro";
import type { Locale } from "../../lib/i18n";
import { UTIL_TOOLS } from "../../lib/tools";
interface Props { locale?: Locale; }
const { locale = "pt" } = Astro.props;
const meta = UTIL_TOOLS.find((t) => t.id === "ua")!;
const T = {
  pt: { h2: "Inserir User-Agent", btnMy: "Usar Meu User-Agent", btnParse: "Analisar User-Agent", h2Res: "Classificação & Sinais" },
  de: { h2: "User-Agent eingeben", btnMy: "Meinen User-Agent nutzen", btnParse: "User-Agent analysieren", h2Res: "Klassifizierung & Signale" },
  zh: { h2: "输入 User-Agent 字符串", btnMy: "使用当前浏览器 UA", btnParse: "解析 User-Agent", h2Res: "分类与风险信号" },
  en: { h2: "Enter User-Agent String", btnMy: "Use My User-Agent", btnParse: "Parse User-Agent", h2Res: "Classification & Signals" },
}[locale];
const L = {
  pt: {
    unk: "Desconhecido", msCorp: "Cliente Corporativo Microsoft",
    stdTraffic: "Tráfego de Navegador / Cliente Padrão",
    cliAlert: "ALERTA: Cliente CLI / Script Automatizado (verificar legitimidade em logs de auth)",
    headlessAlert: "ALERTA: Automação Headless (possível brute-force, credential stuffing ou scraping)",
    os: "Sistema Operacional", client: "Cliente / Navegador", dev: "Dispositivo", risk: "Sinal de Risco SOC",
  },
  de: {
    unk: "Unbekannt", msCorp: "Microsoft Enterprise-Client",
    stdTraffic: "Standard-Browser- / Client-Traffic",
    cliAlert: "WARNUNG: CLI-Client / Automatisiertes Skript (Legitimität in Auth-Logs prüfen)",
    headlessAlert: "WARNUNG: Headless-Automatisierung (mögliches Brute-Force, Credential Stuffing oder Scraping)",
    os: "Betriebssystem", client: "Client / Browser", dev: "Gerät", risk: "SOC-Risikosignal",
  },
  zh: {
    unk: "未知", msCorp: "Microsoft 企业客户端",
    stdTraffic: "标准浏览器 / 客户端流量",
    cliAlert: "告警：CLI 客户端 / 自动化脚本（请在身份验证日志中核实合法性）",
    headlessAlert: "告警：无头浏览器自动化（可能涉及暴力破解、撞库或爬虫）",
    os: "操作系统", client: "客户端 / 浏览器", dev: "设备类型", risk: "SOC 风险信号",
  },
  en: {
    unk: "Unknown", msCorp: "Microsoft Enterprise Client",
    stdTraffic: "Standard Browser / Client Traffic",
    cliAlert: "ALERT: CLI Client / Automated Script (verify legitimacy in auth logs)",
    headlessAlert: "ALERT: Headless Automation (possible brute-force, credential stuffing, or scraping)",
    os: "Operating System", client: "Client / Browser", dev: "Device", risk: "SOC Risk Signal",
  },
}[locale];
---

<ToolShell
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  badge="Logs & Web"
  icon="🕵️"
>
  <div class="tool-card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem;">
      <h2 style="margin:0;">{T.h2}</h2>
      <button id="btn-myua" type="button" class="tool-btn secondary">{T.btnMy}</button>
    </div>
    <textarea
      id="ua-input"
      class="tool-textarea"
      rows="3"
      placeholder="Mozilla/5.0 ..."
      aria-label={T.h2}
    ></textarea>
    <div style="margin-top:.75rem;">
      <button id="btn-parse-ua" type="button" class="tool-btn">{T.btnParse}</button>
    </div>
  </div>

  <div id="ua-result-card" class="tool-card" style="display:none;">
    <h2>{T.h2Res}</h2>
    <div id="ua-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline define:vars={{ L, locale }}>
  (() => {
    const input = document.getElementById('ua-input');
    const card = document.getElementById('ua-result-card');
    const grid = document.getElementById('ua-grid');

    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      const l = document.createElement('div');
      l.className = 'kv-label';
      l.textContent = label;
      const v = document.createElement('div');
      v.className = 'kv-value';
      v.textContent = value;
      box.appendChild(l);
      box.appendChild(v);
      grid.appendChild(box);
    }

    function parseUA(ua) {
      const s = (ua || '').trim();
      if (!s) {
        card.style.display = 'none';
        return;
      }

      let os = L.unk;
      if (/Windows NT 10\.0/i.test(s)) os = 'Windows 10 / 11 / Server 2016+';
      else if (/Windows NT 6\.3/i.test(s)) os = 'Windows 8.1 / Server 2012 R2';
      else if (/Mac OS X/i.test(s)) os = 'macOS';
      else if (/Android/i.test(s)) os = 'Android';
      else if (/iPhone|iPad|iOS/i.test(s)) os = 'iOS / iPadOS';
      else if (/Linux/i.test(s)) os = 'Linux';

      let browser = L.unk;
      let isAutomated = false;
      if (/curl\//i.test(s)) { browser = 'cURL CLI'; isAutomated = true; }
      else if (/python-requests|aiohttp|urllib/i.test(s)) { browser = 'Python HTTP Client'; isAutomated = true; }
      else if (/PowerShell|WindowsPowerShell/i.test(s)) { browser = 'PowerShell Client'; isAutomated = true; }
      else if (/Go-http-client/i.test(s)) { browser = 'Go HTTP Client'; isAutomated = true; }
      else if (/axios|node-fetch|undici/i.test(s)) { browser = 'Node.js HTTP Client'; isAutomated = true; }
      else if (/Edg\//i.test(s)) browser = 'Microsoft Edge';
      else if (/OPR\//i.test(s)) browser = 'Opera';
      else if (/Chrome\//i.test(s)) browser = 'Google Chrome / Chromium';
      else if (/Firefox\//i.test(s)) browser = 'Mozilla Firefox';
      else if (/Safari\//i.test(s)) browser = 'Apple Safari';
      else if (/BAV2ROPC|Microsoft Office|Outlook/i.test(s)) browser = L.msCorp;

      let riskSignal = L.stdTraffic;
      if (isAutomated) riskSignal = L.cliAlert;
      else if (/HeadlessChrome|PhantomJS|Selenium|Playwright|Puppeteer/i.test(s)) {
        riskSignal = L.headlessAlert;
      }

      const ctxLabel = { pt: 'Contexto SOC', de: 'SOC-Kontext', zh: 'SOC 研判上下文', en: 'SOC Context' }[locale] || 'SOC Context';
      let ctxText = {
        pt: 'Navegador interativo padrão. Valide em SigninLogs se o dispositivo está marcado como gerenciado (IsCompliant).',
        de: 'Standard-Browser. Prüfen Sie in SigninLogs, ob das Gerät als konform (IsCompliant) markiert ist.',
        zh: '常规交互式浏览器。请在 SigninLogs 中核实设备是否合规 (IsCompliant)。',
        en: 'Standard interactive browser. Check SigninLogs to verify device compliance (IsCompliant).',
      }[locale];
      if (/BAV2ROPC/i.test(s)) {
        ctxText = {
          pt: 'Fluxo ROPC / Autenticação Legada (BAV2ROPC) sem desafio interativo de MFA. Forte candidato a bloqueio via Conditional Access.',
          de: 'ROPC / Legacy-Authentifizierung (BAV2ROPC) ohne interaktive MFA. Sollte per Conditional Access blockiert werden.',
          zh: 'ROPC / 旧版身份验证 (BAV2ROPC)，无交互式 MFA 校验，建议通过条件访问阻断。',
          en: 'ROPC / Legacy Auth (BAV2ROPC) without interactive MFA challenge. Strong candidate to block via Conditional Access.',
        }[locale];
      } else if (/HeadlessChrome|PhantomJS|Selenium|Playwright|Puppeteer/i.test(s)) {
        ctxText = {
          pt: 'Automação headless detectada. Pode indicar ferramenta de phishing AitM (Evilginx/Modlishka) ou scraping automatizado.',
          de: 'Headless-Automatisierung erkannt. Kann auf AitM-Phishing-Tools oder automatisiertes Scraping hinweisen.',
          zh: '检测到无头浏览器自动化，可能涉及 AitM 钓鱼代理或自动化探测。',
          en: 'Headless browser automation detected. May indicate AitM phishing frameworks or automated scraping.',
        }[locale];
      } else if (isAutomated) {
        ctxText = {
          pt: 'Cliente CLI/Script. Comum em pipelines legítimas ou ataques de password spray e replay de tokens roubados.',
          de: 'CLI-/Skript-Client. Typisch für Pipelines, aber auch für Password-Spraying oder Token-Replay.',
          zh: 'CLI/脚本客户端。常见于自动化流水线，也常用于密码喷洒或令牌重放攻击。',
          en: 'CLI/Script client. Common in pipelines as well as password spray or stolen token replay attacks.',
        }[locale];
      }

      grid.innerHTML = '';
      addKv(L.os, os);
      addKv(L.client, browser);
      addKv(L.dev, /Mobile|Android|iPhone/i.test(s) ? 'Mobile' : (isAutomated ? 'CLI / Script' : 'Desktop'));
      addKv(L.risk, riskSignal);
      const wideBox = document.createElement('div');
      wideBox.className = 'kv-box wide';
      wideBox.innerHTML = `<div class="kv-label">${ctxLabel}</div><div class="kv-value">${ctxText}</div>`;
      grid.appendChild(wideBox);

      card.style.display = '';
    }

    document.getElementById('btn-parse-ua')?.addEventListener('click', () => parseUA(input.value));
    document.getElementById('btn-myua')?.addEventListener('click', () => {
      input.value = navigator.userAgent;
      parseUA(input.value);
    });

    input.value = navigator.userAgent;
    parseUA(input.value);
  })();
</script>


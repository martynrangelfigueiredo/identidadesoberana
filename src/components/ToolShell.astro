---
import Base from "../layouts/Base.astro";
import { getLocaleFromPath, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  badge: string;
  icon: string;
  locale?: Locale;
}

const { title, description, badge, icon } = Astro.props;
const currentLocale = Astro.props.locale || getLocaleFromPath(Astro.url.pathname);
const utilHome = currentLocale === "pt" ? "/util/" : `/${currentLocale}/util/`;

const SHELL_COPY: Record<Locale, { suffix: string; back: string; privacy: string; copy: string; copied: string; dark: string; light: string }> = {
  pt: {
    suffix: "Ferramentas",
    back: "← Voltar para todas as Ferramentas",
    privacy: "Arquitetura privativa · Zero cookies · Sem rastreamento",
    copy: "Copiar",
    copied: "Copiado!",
    dark: "🌙 Terminal",
    light: "☀️ Claro",
  },
  de: {
    suffix: "Tools",
    back: "← Zurück zu allen Tools",
    privacy: "Datenschutzfreundliche Architektur · Keine Cookies · Kein Tracking",
    copy: "Kopieren",
    copied: "Kopiert!",
    dark: "🌙 Terminal",
    light: "☀️ Hell",
  },
  zh: {
    suffix: "实用工具",
    back: "← 返回全部工具",
    privacy: "隐私优先架构 · 零 Cookie · 无追踪",
    copy: "复制",
    copied: "已复制!",
    dark: "🌙 终端暗色",
    light: "☀️ 浅色",
  },
  en: {
    suffix: "Tools",
    back: "← Back to all tools",
    privacy: "Privacy-first architecture · Zero cookies · No tracking",
    copy: "Copy",
    copied: "Copied!",
    dark: "🌙 Terminal",
    light: "☀️ Light",
  },
};

const t = SHELL_COPY[currentLocale];
---

<Base title={`${title} — ${t.suffix}`} description={description} locale={currentLocale}>
  <section class="tool-page container">
    <div class="tool-breadcrumb">
      <a href={utilHome} class="back-link">{t.back}</a>
      <span class="tool-badge">{badge}</span>
    </div>

    <header class="tool-header">
      <h1>
        <span aria-hidden="true">{icon}</span> {title}
      </h1>
      <p class="tool-desc">{description}</p>
      <div class="privacy-pill">
        <span class="dot" aria-hidden="true"></span>
        <span>{t.privacy}</span>
      </div>
    </header>

    <div class="tool-workspace" data-copy={t.copy} data-copied={t.copied} data-dark={t.dark} data-light={t.light}>
      <slot />
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const workspace = document.querySelector('.tool-workspace');
    if (!workspace) return;

    const lblCopy = workspace.getAttribute('data-copy') || 'Copiar';
    const lblCopied = workspace.getAttribute('data-copied') || 'Copiado!';
    const lblDark = workspace.getAttribute('data-dark') || '🌙 Terminal';
    const lblLight = workspace.getAttribute('data-light') || '☀️ Claro';

    const copySvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;

    function attachCopyHandlers() {
      // 1. Caixas Key-Value (.kv-box) exceto links (portal-card)
      workspace.querySelectorAll('.kv-box:not(a)').forEach((box) => {
        if (box.querySelector('.kv-copy-btn')) return;
        const valEl = box.querySelector('.kv-value');
        if (!valEl) return;

        box.classList.add('has-copy');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'kv-copy-btn';
        btn.title = 'Copiar valor';
        btn.setAttribute('aria-label', 'Copiar valor');
        btn.innerHTML = copySvg;

        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const text = valEl.innerText.trim();
          if (!text || text === '—') return;
          try {
            await navigator.clipboard.writeText(text);
            btn.innerHTML = '✔';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.innerHTML = copySvg;
              btn.classList.remove('copied');
            }, 1500);
          } catch (err) {
            console.error('Erro ao copiar:', err);
          }
        });
        box.appendChild(btn);
      });

      // 2. Blocos de saída de código (.code-out)
      workspace.querySelectorAll('.code-out').forEach((pre) => {
        if (pre.querySelector('.out-copy-btn')) return;
        pre.classList.add('has-copy');

        const themeBtn = document.createElement('button');
        themeBtn.type = 'button';
        themeBtn.className = 'code-theme-btn';
        themeBtn.setAttribute('aria-label', 'Alternar tema do bloco');
        themeBtn.textContent = document.documentElement.dataset.codeTheme === 'dark' ? lblLight : lblDark;
        themeBtn.addEventListener('click', () => {
          const next = document.documentElement.dataset.codeTheme === 'dark' ? '' : 'dark';
          if (next) document.documentElement.dataset.codeTheme = 'dark';
          else delete document.documentElement.dataset.codeTheme;
          try { localStorage.setItem('is_code_theme', next || 'light'); } catch {}
          document.querySelectorAll('.code-theme-btn').forEach((b) => {
            b.textContent = next ? lblLight : lblDark;
          });
        });

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'out-copy-btn';
        btn.setAttribute('aria-label', lblCopy);
        btn.innerHTML = `${copySvg} ${lblCopy}`;

        btn.addEventListener('click', async () => {
          const text = Array.from(pre.childNodes)
            .filter((n) => n !== btn && n !== themeBtn)
            .map((n) => n.textContent)
            .join('')
            .trim();
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            btn.innerHTML = `✔ ${lblCopied}`;
            btn.classList.add('copied');
            setTimeout(() => {
              btn.innerHTML = `${copySvg} ${lblCopy}`;
              btn.classList.remove('copied');
            }, 1800);
          } catch (err) {
            console.error('Erro ao copiar:', err);
          }
        });
        pre.appendChild(themeBtn);
        pre.appendChild(btn);
      });
    }

    attachCopyHandlers();
    const observer = new MutationObserver(() => attachCopyHandlers());
    observer.observe(workspace, { childList: true, subtree: true });
  })();
</script>

<style is:global>
  .tool-page {
    padding-block: 2rem 4rem;
    max-width: 980px;
  }
  .tool-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .75rem;
    margin-bottom: 1.25rem;
  }
  .back-link {
    font: 700 .9rem var(--is-fonte-titulo);
    color: var(--is-verde-escuro);
    text-decoration: none;
    padding: .35rem .75rem;
    border-radius: var(--is-raio-pill);
    background: var(--is-verde-claro);
    transition: background .15s ease;
  }
  .back-link:hover {
    background: #d3f2de;
  }
  .tool-badge {
    font: 800 .78rem var(--is-fonte-mono);
    text-transform: uppercase;
    letter-spacing: .04em;
    background: var(--is-amarelo);
    color: var(--is-tinta);
    padding: .25rem .7rem;
    border-radius: var(--is-raio-pill);
  }
  .tool-header h1 {
    font-size: clamp(1.7rem, 3.2vw, 2.35rem);
    margin: 0 0 .5rem;
  }
  .tool-desc {
    color: var(--is-cinza);
    font-size: 1.05rem;
    margin: 0 0 .85rem;
    max-width: 72ch;
  }
  .privacy-pill {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    font: 600 .82rem var(--is-fonte-texto);
    color: var(--is-verde-escuro);
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: .25rem .75rem;
    border-radius: var(--is-raio-pill);
    margin-bottom: 1.75rem;
  }
  .privacy-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--is-verde);
  }

  /* Componentes reutilizáveis das ferramentas */
  .tool-card {
    background: var(--is-branco);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-card, 14px);
    padding: 1.35rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .025);
  }
  .tool-card h2, .tool-card h3 {
    margin-top: 0;
    font-size: 1.15rem;
    margin-bottom: .85rem;
  }
  .tool-form-row {
    display: flex;
    gap: .65rem;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .tool-input, .tool-textarea, .tool-select {
    width: 100%;
    font-family: var(--is-fonte-mono);
    font-size: .92rem;
    padding: .7rem .9rem;
    border: 1.5px solid var(--is-borda);
    border-radius: 10px;
    background: #fafafa;
    color: var(--is-tinta);
    transition: border-color .15s ease, background .15s ease;
  }
  .tool-input:focus, .tool-textarea:focus, .tool-select:focus {
    outline: none;
    border-color: var(--is-verde);
    background: var(--is-branco);
  }
  .tool-form-row .tool-input {
    flex: 1 1 260px;
  }
  .tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    font: 800 .92rem var(--is-fonte-titulo);
    padding: .7rem 1.25rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    background: var(--is-verde);
    color: #fff;
    transition: transform .1s ease, background .15s ease;
    white-space: nowrap;
  }
  .tool-btn:hover {
    background: var(--is-verde-escuro);
  }
  .tool-btn:active {
    transform: translateY(1px);
  }
  .tool-btn.secondary {
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
  }
  .tool-btn.secondary:hover {
    background: #d3f2de;
  }
  .tool-btn.outline {
    background: #fff;
    color: var(--is-tinta);
    border: 1.5px solid var(--is-borda);
  }
  .tool-btn.outline:hover {
    border-color: var(--is-verde);
    color: var(--is-verde-escuro);
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: .85rem;
  }
  .kv-box {
    background: #f8fafc;
    border: 1px solid var(--is-borda);
    border-radius: 10px;
    padding: .75rem .9rem;
    position: relative;
  }
  .kv-box.has-copy {
    padding-right: 2.6rem;
  }
  .kv-copy-btn {
    position: absolute;
    top: .55rem;
    right: .55rem;
    background: #fff;
    border: 1px solid var(--is-borda);
    border-radius: 7px;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--is-cinza);
    cursor: pointer;
    transition: all .15s ease;
  }
  .kv-copy-btn:hover, .kv-copy-btn.copied {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
  }
  .kv-label {
    font: 700 .75rem var(--is-fonte-titulo);
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--is-cinza);
    margin-bottom: .25rem;
  }
  .kv-value {
    font: 600 .95rem var(--is-fonte-mono);
    color: var(--is-tinta);
    word-break: break-all;
    user-select: text;
  }
  .code-out {
    position: relative;
    background: #f8fafc;
    border: 1px solid var(--is-borda);
    border-radius: 10px;
    padding: .9rem 1rem;
    font: 500 .88rem/1.55 var(--is-fonte-mono);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
    user-select: text;
  }
  .code-out.has-copy {
    padding-top: 2.35rem;
  }
  .out-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #fff;
    border: 1px solid var(--is-borda);
    border-radius: 7px;
    padding: 3px 9px;
    font: 700 .74rem var(--is-fonte-titulo);
    color: var(--is-cinza);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all .15s ease;
  }
  .out-copy-btn:hover, .out-copy-btn.copied {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
  }
  .pivot-bar {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .75rem;
  }
  .pivot-link {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font: 700 .82rem var(--is-fonte-titulo);
    text-decoration: none;
    padding: .35rem .75rem;
    border-radius: var(--is-raio-pill);
    border: 1px solid var(--is-borda);
    background: #fff;
    color: var(--is-tinta);
    transition: all .15s ease;
  }
  .pivot-link:hover {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
  }
  .status-msg {
    font-size: .9rem;
    margin-top: .65rem;
    font-weight: 600;
  }
  .status-msg.error { color: #b91c1c; }
  .status-msg.ok { color: var(--is-verde-escuro); }
</style>


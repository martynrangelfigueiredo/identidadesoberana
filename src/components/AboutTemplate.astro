---
import Base from "../layouts/Base.astro";
import { type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const content = {
  pt: {
    title: "Sobre",
    description: "A proposta da Identidade Soberana: engenharia de segurança, resposta a incidentes e soberania de dados.",
    chip: "Sobre nós",
    h1Start: "Segurança, identidade e soberania em ",
    h1Highlight: "dois mundos",
    lead: "Acreditamos que segurança da informação e governança de identidades só são efetivas quando combinam o rigor técnico de nuvens corporativas com a autonomia e transparência de infraestruturas soberanas.",
    whyTitle: "Por que existimos?",
    whyP1: "O ecossistema corporativo lida diariamente com milhões de tentativas de fraudes, vazamentos de credenciais e ameaças cibernéticas cada vez mais sofisticadas. No entanto, a discussão de segurança quase sempre comete um de dois erros: ou se rende passivamente à dependência cega de fornecedores proprietários, ou se isola em teorias que não atendem às exigências de escala das grandes organizações.",
    whyP2: "A Identidade Soberana nasceu para unir o melhor dessas duas realidades com foco estrito em engenharia prática:",
    box1Chip: "🏢 Operação Enterprise & Cloud SecOps",
    box1Title: "Escala & Resposta a Incidentes",
    box1Desc: "Focado em analistas de SOC, engenheiros de IAM e especialistas em Cloud Security. Playbooks estruturados de investigação no Microsoft Sentinel, queries avançadas em KQL, auditoria profunda no Entra ID e resposta a incidentes críticos.",
    box2Chip: "🛡️ Nuvem Soberana & Código Aberto",
    box2Title: "Autonomia & Controle Local",
    box2Desc: "Focado em arquiteturas soberanas: gestão de identidades com Keycloak, SIEM aberto com Wazuh, automação com TheHive/Shuffle, federação OIDC e laboratórios locais em Docker/WSL2 sem dependência de telemetria externa.",
    authorTitle: "Quem está por trás",
    authorDesc: "A iniciativa Identidade Soberana é idealizada, mantida e escrita por Martyn Figueiredo, profissional dedicado à interseção entre operações de segurança em nuvem (SOC), governança de identidades (IAM) e conformidade.",
    contactTitle: "Contato e Contribuições",
    btnBlog: "Ver os artigos técnicos →",
  },
  de: {
    title: "Über uns",
    description: "Die Mission von Identidade Soberana: Security Engineering, Incident Response und Datensouveränität.",
    chip: "Über das Projekt",
    h1Start: "Sicherheit, Identität und Souveränität in ",
    h1Highlight: "zwei Welten",
    lead: "Wir glauben, dass Informationssicherheit und Identity Governance erst dann wirksam sind, wenn sie die Skalierbarkeit von Enterprise-Clouds mit der Transparenz und Kontrolle souveräner Architekturen verbinden.",
    whyTitle: "Warum existiert Identidade Soberana?",
    whyP1: "Täglich sehen sich Organisationen mit Credential-Angriffen, Session-Hijacking und Cloud-Intrusionen konfrontiert. Sicherheitsdiskussionen scheitern oft an zwei Extremen: entweder blinde Abhängigkeit von proprietären Big-Tech-Ökosystemen oder praxisferner Purismus ohne Enterprise-Tauglichkeit.",
    whyP2: "Identidade Soberana verbindet diese Welten durch praxisorientiertes Engineering:",
    box1Chip: "🏢 Enterprise SecOps & Cloud Defense",
    box1Title: "Skalierung & Incident Response",
    box1Desc: "Für SOC-Analysten und Cloud-Security-Engineers. Praxiserprobte Incident-Response-Playbooks für Microsoft Sentinel, KQL-Queries, Entra ID-Audits und Abwehr hochentwickelter Bedrohungen.",
    box2Chip: "🛡️ Souveräne Cloud & Open Source",
    box2Title: "Autonomie & Lokale Kontrolle",
    box2Desc: "Fokus auf digitale Souveränität: Identitätsmanagement mit Keycloak, Open-Source-SIEM mit Wazuh, Automatisierung mit TheHive/Shuffle und lokale Laborumgebungen in Docker/WSL2 ohne Drittanbieter-Telemetrie.",
    authorTitle: "Initiator & Autor",
    authorDesc: "Die Initiative Identidade Soberana wird von Martyn Figueiredo geleitet und gepflegt — Spezialist an der Schnittstelle von Cloud-Sicherheitsoperationen (SOC), Identity Governance und Datenschutz.",
    contactTitle: "Kontakt & Austausch",
    btnBlog: "Technische Artikel lesen →",
  },
  zh: {
    title: "关于",
    description: "Identidade Soberana 的使命：云安全工程、应急响应实战与数据主权治理。",
    chip: "关于项目",
    h1Start: "贯穿不同场景的",
    h1Highlight: "数字安全与主权",
    lead: "我们坚信，信息安全与身份治理只有将大型企业级云的工程深度与主权数字架构的自主可控有机融合，才能构建起真正的纵深防御。",
    whyTitle: "项目缘起",
    whyP1: "企业每天面临数以百万计的撞库攻击、凭据泄露与云上入侵。然而安全领域的讨论常走向两个极端：要么完全受制于专有商业软件的黑盒，要么停留在难以落地的理论层面。",
    whyP2: "Identidade Soberana 正是为打破这一壁垒而生，专注于两大核心工程支柱：",
    box1Chip: "🏢 企业级安全运营与云防御",
    box1Title: "规模化防护与应急响应",
    box1Desc: "面向 SOC 分析师、IAM 工程师与云安全专家。提供基于 Microsoft Sentinel 的实战演练手册、深度 KQL 查询、Entra ID 鉴权审计与高危威胁排查方案。",
    box2Chip: "🛡️ 主权云与开源架构",
    box2Title: "自主可控与本地化部署",
    box2Desc: "聚焦数字主权与自主架构：基于 Keycloak 的统一身份源与 SSO、基于 Wazuh 的开源 SIEM/XDR、TheHive/Shuffle 编排以及 Windows Enterprise/WSL2 Docker 实验环境。",
    authorTitle: "主理人与发起人",
    authorDesc: "Identidade Soberana 项目由 Martyn Figueiredo 创立并维护，专注于云安全运营（SOC）、身份权限治理与合规工程。",
    contactTitle: "联系与合作",
    btnBlog: "阅读实战技术文章 →",
  },
  en: {
    title: "About",
    description: "The Identidade Soberana mission: practical SecOps engineering, cloud defense, and sovereign data governance.",
    chip: "About us",
    h1Start: "Security, identity, and sovereignty across ",
    h1Highlight: "two worlds",
    lead: "We believe information security and identity governance only truly succeed when uniting the rigor of enterprise hyperscalers with the autonomy, audibility, and custody of sovereign open-source stacks.",
    whyTitle: "Why We Exist",
    whyP1: "Organizations face millions of credential attacks, token-theft attempts, and cloud intrusions daily. Yet discussions usually fail in one of two ways: either accepting complete lock-in to proprietary black-boxes, or retreating into theoretical purism that cannot scale.",
    whyP2: "Identidade Soberana unites both worlds through hands-on technical engineering:",
    box1Chip: "🏢 Enterprise SecOps & Cloud Defense",
    box1Title: "Scale & Incident Response",
    box1Desc: "Built for SOC analysts, IAM engineers, and detection engineers. Production incident response playbooks for Microsoft Sentinel, battle-tested KQL queries, Entra ID audit trails, and rapid containment.",
    box2Chip: "🛡️ Sovereign Cloud & Open Source",
    box2Title: "Autonomy & Full Custody",
    box2Desc: "Focusing on digital sovereignty: identity federation with Keycloak, open SIEM/XDR with Wazuh, SOAR with TheHive/Shuffle, and local Docker/WSL2 lab deployments with zero external telemetry.",
    authorTitle: "Behind the Project",
    authorDesc: "The Identidade Soberana initiative is designed, authored, and maintained by Martyn Figueiredo, a security practitioner working at the intersection of cloud SecOps, identity governance, and compliance.",
    contactTitle: "Contact & Collaboration",
    btnBlog: "Explore technical playbooks →",
  },
};

const t = content[locale];
const blogUrl = locale === "pt" ? "/blog/" : `/${locale}/blog/`;
---
<Base title={t.title} description={t.description} locale={locale}>
  <section class="artigo-header">
    <div class="estreito">
      <span class="chip">{t.chip}</span>
      <h1>{t.h1Start}<span class="hl">{t.h1Highlight}</span></h1>
      <p>{t.lead}</p>
    </div>
  </section>

  <div class="estreito prosa">
    <h2>{t.whyTitle}</h2>
    <p>{t.whyP1}</p>
    <p>{t.whyP2}</p>

    <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));margin:2.5rem 0;">
      <div style="background:var(--is-verde-claro);border:1px solid var(--is-borda);border-radius:var(--is-raio-md);padding:1.5rem;">
        <span class="chip" style="background:var(--is-branco);margin-bottom:.75rem;">{t.box1Chip}</span>
        <h3 style="margin:.5rem 0;color:var(--is-verde-escuro);">{t.box1Title}</h3>
        <p style="font-size:.95rem;color:var(--is-tinta);margin:0;">{t.box1Desc}</p>
      </div>

      <div style="background:var(--is-verde-nevoa);border:1px solid var(--is-borda);border-radius:var(--is-raio-md);padding:1.5rem;">
        <span class="chip" style="background:var(--is-branco);margin-bottom:.75rem;">{t.box2Chip}</span>
        <h3 style="margin:.5rem 0;color:var(--is-verde-escuro);">{t.box2Title}</h3>
        <p style="font-size:.95rem;color:var(--is-tinta);margin:0;">{t.box2Desc}</p>
      </div>
    </div>

    <h2>{t.authorTitle}</h2>
    <p>{t.authorDesc} (<a href="https://linkedin.com/in/martynfigueiredo" target="_blank" rel="noopener">LinkedIn</a>).</p>

    <h2>{t.contactTitle}</h2>
    <ul>
      <li><strong>E-mail:</strong> <a href="mailto:administrador@identidadesoberana.com.br"><code>administrador@identidadesoberana.com.br</code></a></li>
      <li><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/martynfigueiredo" target="_blank" rel="noopener">linkedin.com/in/martynfigueiredo</a></li>
    </ul>

    <p style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:2rem;">
      <a class="btn" href={blogUrl}>{t.btnBlog}</a>
      <a class="btn sec" href="https://linkedin.com/in/martynfigueiredo" target="_blank" rel="noopener">Conectar no LinkedIn</a>
    </p>
  </div>
</Base>

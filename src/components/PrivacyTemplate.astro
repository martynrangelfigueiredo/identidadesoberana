const t = content[locale];
---
<Base title={t.title} description={t.description} locale={locale}>
  <section class="artigo-header">
    <div class="estreito">
      <span class="chip">{t.chip}</span>
      <h1>{t.h1Start}<span class="hl">{t.h1Highlight}</span></h1>
      <p>{t.lead}</p>
      <p style="font-size:.85rem;color:var(--is-cinza);margin-top:.5rem;">{t.updated}</p>
    </div>
  </section>

  <div class="estreito prosa">
    <h2>{t.controllerTitle}</h2>
    <p>{t.controllerBody}</p>
    <p><strong>{t.contactLabel}</strong> <a href="mailto:administrador@identidadesoberana.com.br">administrador@identidadesoberana.com.br</a></p>

    <h2>{t.cookiesTitle}</h2>
    <p>{t.cookiesP1}</p>
    <p>{t.cookiesP2}</p>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>{t.thKey}</th>
            <th>{t.thType}</th>
            <th>{t.thPurpose}</th>
            <th>{t.thRetention}</th>
          </tr>
        </thead>
        <tbody>
          {t.rows.map(([k, st, p, r]) => (
            <tr>
              <td><code>{k}</code></td>
              <td><code>{st}</code></td>
              <td>{p}</td>
              <td>{r}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="margin:1.25rem 0 2rem;">
      <button id="btn-clear-local-storage" type="button" class="btn btn-contorno">{t.clearBtn}</button>
      <p id="clear-local-status" style="font-size:.9rem;font-weight:600;color:var(--is-verde-escuro);margin-top:.6rem;" hidden>{t.clearOk}</p>
    </div>

    <h2>{t.toolsTitle}</h2>
    <p>{t.toolsP1}</p>
    <p>{t.toolsP2}</p>

    <h2>{t.lawsTitle}</h2>

    <h3>{t.lgpdTitle}</h3>

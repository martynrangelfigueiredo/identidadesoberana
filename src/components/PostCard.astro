---
import type { CollectionEntry } from "astro:content";
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const data = post.data.date.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
---
<a class="card" href={`/blog/${post.id}/`}>
  <span class="chip">{post.data.categoria}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <span class="meta"><time datetime={post.data.date.toISOString()}>{data}</time> · {post.data.nivel}</span>
</a>


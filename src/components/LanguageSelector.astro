---
// LanguageSelector.astro — Seletor de idioma nativo e estático (Zero dependências externas)
// Ordem obrigatória: 1º Alemão (DE de), 2º Mandarim da China continental (CN zh), 3º Inglês (US en)
import { getLocaleFromPath, getLocalizedPath, LOCALE_LABELS, SELECTOR_ORDER } from "../lib/i18n";

const pathname = Astro.url.pathname;
const currentLocale = getLocaleFromPath(pathname);
const activeMeta = LOCALE_LABELS[currentLocale];
---
<div class="lang-selector-custom" id="lang-selector">
  <button type="button" class="lang-trigger" id="lang-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Selecionar idioma de navegação">
    <svg class="lang-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <strong class="c-badge">{activeMeta.country}</strong>
    <span class="l-badge">{activeMeta.langCode}</span>
    <span class="lang-arrow" aria-hidden="true">▾</span>
  </button>

  <ul class="lang-menu" id="lang-menu" role="listbox" aria-label="Idiomas disponíveis">
    {SELECTOR_ORDER.map((loc) => {
      const meta = LOCALE_LABELS[loc];
      const targetUrl = getLocalizedPath(pathname, loc);
      const isActive = loc === currentLocale;
      return (
        <li role="option" aria-selected={isActive ? "true" : "false"} class={isActive ? "active" : ""}>
          <a href={targetUrl} class="lang-item-link">
            <span class="flag">{meta.flag}</span>
            <strong class="menu-c">{meta.country}</strong>
            <span class="menu-l">{meta.langCode}</span>
            <span class="menu-name">{meta.name}</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .lang-selector-custom {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    height: 38px;
    padding: 0 .6rem 0 .55rem;
    background: var(--is-branco);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-pill);
    box-shadow: var(--is-sombra-1);
    color: var(--is-tinta);
    cursor: pointer;
    transition: all .15s ease;
  }
  .lang-trigger:hover,
  .lang-selector-custom.open .lang-trigger {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
  }

  .lang-icon {
    color: var(--is-verde-escuro);
    flex-shrink: 0;
    margin-right: 2px;
  }

  /* Código do País GRANDE / Código do Idioma pequeno */
  .c-badge {
    font: 900 .85rem/1 var(--is-fonte-titulo);
    color: var(--is-verde-escuro);
    letter-spacing: .02em;
  }
  .l-badge {
    font: 600 .72rem/1 var(--is-fonte-texto);
    color: var(--is-cinza);
    text-transform: lowercase;
  }
  .lang-arrow {
    font-size: .65rem;
    color: var(--is-cinza);
    margin-left: 2px;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 1000;
    background: var(--is-branco);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-md);
    box-shadow: var(--is-sombra-2);
    min-width: 175px;
    padding: .4rem;
    margin: 0;
    list-style: none;
    display: none;
    flex-direction: column;
    gap: 2px;
    animation: fadeIn .15s ease-out;
  }
  .lang-selector-custom.open .lang-menu {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .lang-menu li {
    margin: 0;
    padding: 0;
    border-radius: var(--is-raio-sm);
  }
  .lang-item-link {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem .65rem;
    color: var(--is-tinta);
    text-decoration: none;
    border-radius: var(--is-raio-sm);
    transition: background .12s ease;
  }
  .lang-item-link:hover {
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
  }
  .lang-menu li.active .lang-item-link {
    background: var(--is-verde-nevoa);
    color: var(--is-verde-escuro);
    font-weight: 700;
  }

  .flag {
    font-size: 1rem;
    line-height: 1;
  }
  .menu-c {
    font: 900 .85rem var(--is-fonte-titulo);
    color: var(--is-verde-escuro);
  }
  .menu-l {
    font: 600 .72rem var(--is-fonte-texto);
    color: var(--is-cinza);
  }
  .menu-name {
    margin-left: auto;
    font-size: .78rem;
    color: var(--is-cinza);
  }

  @media (max-width: 480px) {
    .lang-trigger {
      height: 36px;
      padding: 0 .5rem 0 .45rem;
    }
    .c-badge { font-size: .8rem; }
    .l-badge { font-size: .68rem; }
  }
</style>

<script is:inline>
  (() => {
    const container = document.getElementById('lang-selector');
    const trigger = document.getElementById('lang-trigger');
    if (!container || !trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = container.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        container.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

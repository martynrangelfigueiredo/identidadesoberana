---
// LanguageSelector.astro — Seletor compacto e responsivo de idiomas
// Ordem obrigatória: 1º Alemão (de), 2º Mandarim da China continental (zh-CN), 3º Inglês (en)
---
<div class="lang-selector-compact" aria-label="Traduzir página">
  <span class="lang-icon" aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
  </span>
  <select id="lang-select" class="lang-select" aria-label="Traduzir para outro idioma">
    <option value="pt">🇧🇷 PT</option>
    <option value="de">🇩🇪 Deutsch</option>
    <option value="zh-CN">🇨🇳 简体中文</option>
    <option value="en">🇺🇸 English</option>
  </select>
  <span class="lang-arrow" aria-hidden="true">▾</span>
  <div id="google_translate_element" style="display:none;" aria-hidden="true"></div>
</div>

<style>
  .lang-selector-compact {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: var(--is-branco);
    border: 1px solid var(--is-borda);
    border-radius: var(--is-raio-pill);
    padding: 0 .6rem 0 .5rem;
    box-shadow: var(--is-sombra-1);
    transition: all .15s ease;
    height: 38px;
    flex-shrink: 0;
  }
  .lang-selector-compact:hover,
  .lang-selector-compact:focus-within {
    border-color: var(--is-verde);
    background: var(--is-verde-claro);
  }
  .lang-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--is-verde-escuro);
    margin-right: .25rem;
    flex-shrink: 0;
  }
  .lang-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    font: 700 .82rem var(--is-fonte-titulo);
    color: var(--is-tinta);
    cursor: pointer;
    padding-right: .85rem;
    outline: none;
    line-height: 36px;
    height: 36px;
  }
  .lang-arrow {
    position: absolute;
    right: .45rem;
    pointer-events: none;
    font-size: .75rem;
    color: var(--is-cinza);
  }
  @media (max-width: 480px) {
    .lang-selector-compact {
      height: 36px;
      padding: 0 .45rem 0 .4rem;
    }
    .lang-select {
      font-size: .76rem;
      padding-right: .7rem;
    }
  }
</style>

<script is:inline>
  function googleTranslateElementInit() {
    if (window.google && window.google.translate) {
      new window.google.translate.TranslateElement({
        pageLanguage: 'pt',
        includedLanguages: 'de,zh-CN,en',
        autoDisplay: false
      }, 'google_translate_element');
    }
  }
  window.googleTranslateElementInit = googleTranslateElementInit;

  if (!document.getElementById('google-translate-script')) {
    const s = document.createElement('script');
    s.id = 'google-translate-script';
    s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    s.async = true;
    document.head.appendChild(s);
  }

  function initLangSelect() {
    const select = document.getElementById('lang-select');
    if (!select) return;

    // Detecta o idioma ativo a partir dos cookies
    const match = document.cookie.match(/googtrans=\/pt\/([^;]+)/);
    const activeLang = match ? match[1] : 'pt';
    
    if (activeLang && select.querySelector(`option[value="${activeLang}"]`)) {
      select.value = activeLang;
    }

    select.addEventListener('change', () => {
      const targetLang = select.value;

      if (targetLang === 'pt') {
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + location.hostname;
        location.reload();
        return;
      }

      document.cookie = `googtrans=/pt/${targetLang}; path=/;`;
      document.cookie = `googtrans=/pt/${targetLang}; path=/; domain=${location.hostname};`;

      const combo = document.querySelector('.goog-te-combo');
      if (combo) {
        combo.value = targetLang;
        combo.dispatchEvent(new Event('change'));
      } else {
        location.reload();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLangSelect);
  } else {
    initLangSelect();
  }
</script>

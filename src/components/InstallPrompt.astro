---
// InstallPrompt.astro — Notificação discreta flutuante (Bottom-Sheet / Toast)
// Não ocupa espaço no cabeçalho nem interfere no seletor de tradução
---
<aside id="pwa-install-banner" class="install-toast" style="display:none;" aria-label="Instalar Identidade Soberana">
  <div class="toast-content">
    <div class="toast-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
    </div>
    <div class="toast-text">
      <strong>Instalar aplicativo</strong>
      <span>Acesse os playbooks offline e direto da tela de início.</span>
    </div>
  </div>
  <div class="toast-actions">
    <button id="pwa-install-btn" type="button" class="btn-install-confirm">Instalar</button>
    <button id="pwa-dismiss-btn" type="button" class="btn-install-dismiss" aria-label="Fechar aviso">Agora não</button>
  </div>
</aside>

<style>
  .install-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    max-width: 380px;
    width: calc(100% - 32px);
    background: var(--is-branco);
    border: 2px solid var(--is-verde);
    border-radius: var(--is-raio-lg);
    box-shadow: 0 12px 36px rgba(0, 97, 42, 0.18), 0 4px 12px rgba(27, 43, 34, 0.08);
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .toast-content {
    display: flex;
    align-items: flex-start;
    gap: .85rem;
  }
  .toast-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--is-verde-claro);
    color: var(--is-verde-escuro);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .toast-text {
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }
  .toast-text strong {
    font: 800 .95rem var(--is-fonte-titulo);
    color: var(--is-tinta);
  }
  .toast-text span {
    font-size: .82rem;
    color: var(--is-cinza);
    line-height: 1.35;
  }

  .toast-actions {
    display: flex;
    gap: .5rem;
    justify-content: flex-end;
    margin-top: .2rem;
  }
  .btn-install-confirm {
    background: var(--is-verde);
    color: var(--is-branco);
    border: none;
    font: 800 .85rem var(--is-fonte-titulo);
    padding: .45rem 1rem;
    border-radius: var(--is-raio-pill);
    cursor: pointer;
    transition: background .15s ease;
  }
  .btn-install-confirm:hover {
    background: var(--is-verde-escuro);
  }
  .btn-install-dismiss {
    background: transparent;
    color: var(--is-cinza);
    border: none;
    font: 700 .82rem var(--is-fonte-titulo);
    padding: .45rem .75rem;
    cursor: pointer;
    border-radius: var(--is-raio-pill);
  }
  .btn-install-dismiss:hover {
    background: var(--is-verde-nevoa);
    color: var(--is-tinta);
  }

  @media (max-width: 600px) {
    .install-toast {
      bottom: 16px;
      left: 16px;
      right: 16px;
      width: auto;
      max-width: none;
      padding: .9rem 1rem;
    }
  }
</style>

<script is:inline>
  let deferredPrompt;
  const banner = document.getElementById('pwa-install-banner');
  const installBtn = document.getElementById('pwa-install-btn');
  const dismissBtn = document.getElementById('pwa-dismiss-btn');

  // Não exibe se o usuário já dispensou recentemente
  const isDismissed = sessionStorage.getItem('pwa_install_dismissed');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;

    if (banner && !isDismissed) {
      banner.style.display = 'flex';
    }
  });

  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      banner.style.display = 'none';
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
    });
  }

  if (dismissBtn) {
    dismissBtn.addEventListener('click', () => {
      if (banner) banner.style.display = 'none';
      sessionStorage.setItem('pwa_install_dismissed', '1');
    });
  }

  window.addEventListener('appinstalled', () => {
    if (banner) banner.style.display = 'none';
    deferredPrompt = null;
  });
</script>

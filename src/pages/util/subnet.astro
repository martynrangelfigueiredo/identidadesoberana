---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
  title="Calculadora de Sub-rede & CIDR"
  description="Calcule máscara de sub-rede, wildcard, endereço de rede, broadcast, primeiro/último host utilizável e representação binária a partir de um bloco CIDR."
  badge="Rede & IP"
  icon="🧮"
>
  <div class="tool-card">
    <h2>Calcular Bloco IPv4 / CIDR</h2>
    <div class="tool-form-row">
      <input id="sub-ip" type="text" class="tool-input" value="10.20.30.45" placeholder="Endereço IP (ex: 10.20.30.45)" aria-label="Endereço IPv4" />
      <select id="sub-cidr" class="tool-select" style="max-width:190px;" aria-label="Prefixo CIDR"></select>
      <button id="btn-subnet" type="button" class="tool-btn">Calcular</button>
    </div>
    <p id="sub-status" class="status-msg"></p>
  </div>

  <div class="tool-card">
    <h2>Detalhes da Sub-rede</h2>
    <div id="sub-grid" class="tool-grid"></div>
  </div>
</ToolShell>

<script is:inline>
  (() => {
    const ipEl = document.getElementById('sub-ip');
    const cidrEl = document.getElementById('sub-cidr');
    const grid = document.getElementById('sub-grid');
    const statusEl = document.getElementById('sub-status');

    for (let p = 32; p >= 1; p--) {
      const opt = document.createElement('option');
      opt.value = String(p);
      opt.textContent = `/${p}`;
      if (p === 24) opt.selected = true;
      cidrEl.appendChild(opt);
    }

    function toStr(n) {
      return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
    }
    function toBin(n) {
      return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255]
        .map((x) => x.toString(2).padStart(8, '0'))
        .join('.');
    }
    function addKv(label, value) {
      const box = document.createElement('div');
      box.className = 'kv-box';
      box.innerHTML = `<div class="kv-label">${label}</div><div class="kv-value">${value}</div>`;
      grid.appendChild(box);
    }

    function calc() {
      const raw = ipEl.value.trim();
      const [ipOnly, inlinePrefix] = raw.split('/');
      if (inlinePrefix && !isNaN(Number(inlinePrefix))) {
        cidrEl.value = inlinePrefix;
        ipEl.value = ipOnly;
      }

      const parts = ipOnly.split('.').map(Number);
      if (parts.length !== 4 || parts.some((x) => isNaN(x) || x < 0 || x > 255)) {
        statusEl.textContent = 'Informe um endereço IPv4 válido.';
        statusEl.className = 'status-msg error';
        return;
      }

      const p = Number(cidrEl.value);
      const ipInt = ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
      const mask = p === 0 ? 0 : (0xffffffff << (32 - p)) >>> 0;
      const wildcard = (~mask) >>> 0;
      const net = (ipInt & mask) >>> 0;
      const bcast = (net | wildcard) >>> 0;
      const total = Math.pow(2, 32 - p);
      const usable = p >= 31 ? total : Math.max(0, total - 2);
      const firstHost = p >= 31 ? net : (net + 1) >>> 0;
      const lastHost = p >= 31 ? bcast : (bcast - 1) >>> 0;

      grid.innerHTML = '';
      addKv('Notação CIDR', `${toStr(net)}/${p}`);
      addKv('Máscara de Sub-rede', toStr(mask));
      addKv('Wildcard Mask (ACL)', toStr(wildcard));
      addKv('Endereço de Rede', toStr(net));
      addKv('Endereço de Broadcast', toStr(bcast));
      addKv('Range Utilizável', `${toStr(firstHost)} – ${toStr(lastHost)}`);
      addKv('Total de IPs / Utilizáveis', `${total.toLocaleString('pt-BR')} / ${usable.toLocaleString('pt-BR')}`);
      addKv('Máscara em Binário', toBin(mask));

      statusEl.textContent = 'Sub-rede calculada.';
      statusEl.className = 'status-msg ok';
    }

    document.getElementById('btn-subnet')?.addEventListener('click', calc);
    cidrEl?.addEventListener('change', calc);
    calc();
  })();
</script>

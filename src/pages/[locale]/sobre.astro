---
import AboutTemplate from "../../components/AboutTemplate.astro";
import { NON_DEFAULT_LOCALES, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
---
<AboutTemplate locale={locale as Locale} />

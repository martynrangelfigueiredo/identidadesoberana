---
import CategoryTemplate from "../../components/CategoryTemplate.astro";

export function getStaticPaths() {
  const cats = ["soc", "iam", "compliance", "privacidade"];
  return cats.map((cat) => ({ params: { categoria: cat } }));
}
const { categoria } = Astro.params;
---
<CategoryTemplate categoriaSlug={categoria!} locale="pt" />

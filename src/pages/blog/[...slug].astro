---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/posts";
import ShareButtons from "../../components/ShareButtons.astro";

export async function getStaticPaths() {
  const posts = await getPosts("pt");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data.date.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
---
<Base title={post.data.title} description={post.data.description}>
  <!-- Dados Estruturados (JSON-LD) para o Artigo / Playbook de SOC -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "TechArticle",
        "headline": post.data.title,
        "description": post.data.description,
        "datePublished": post.data.date.toISOString(),
        "dateModified": post.data.date.toISOString(),
        "inLanguage": "pt-BR",
        "keywords": post.data.tags.join(", "),
        "articleSection": post.data.categoria,
        "proficiencyLevel": post.data.nivel,
        "author": {
          "@type": "Person",
          "name": "Martyn Figueiredo",
          "url": "https://linkedin.com/in/martynfigueiredo"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Identidade Soberana",
          "url": "https://identidadesoberana.com.br",
          "logo": {
            "@type": "ImageObject",
            "url": "https://identidadesoberana.com.br/icons/icon-512.png"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": `https://identidadesoberana.com.br/blog/${post.id}/`
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Início",
            "item": "https://identidadesoberana.com.br"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://identidadesoberana.com.br/blog/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": post.data.categoria,
            "item": `https://identidadesoberana.com.br/categoria/${post.data.categoria.toLowerCase()}/`
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": post.data.title,
            "item": `https://identidadesoberana.com.br/blog/${post.id}/`
          }
        ]
      }
    ]
  })} />

  <article>
    <header class="artigo-header">
      <div class="estreito">
        <a class="chip" href={`/categoria/${post.data.categoria.toLowerCase()}/`}>{post.data.categoria}</a>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{data}</time> · {post.data.nivel}
          {post.data.tags.map((t) => <span>#{t}</span>)}
        </div>
      </div>
    </header>
    <div class="estreito prosa"><Content /></div>
    <div class="estreito">
      <ShareButtons
        title={post.data.title}
        description={post.data.description}
        url={`https://identidadesoberana.com.br/blog/${post.id}/`}
        locale="pt"
      />
    </div>
  </article>
</Base>


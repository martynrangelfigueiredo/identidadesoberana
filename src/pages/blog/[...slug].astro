---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data.date.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="artigo-header">
      <div class="estreito">
        <a class="chip" href={`/categoria/${post.data.categoria.toLowerCase()}/`}>{post.data.categoria}</a>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{data}</time> · {post.data.nivel}
          {post.data.tags.map((t) => <span>#{t}</span>)}
        </div>
      </div>
    </header>
    <div class="estreito prosa"><Content /></div>
  </article>
</Base>

